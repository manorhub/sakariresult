---
// src/pages/admin/settings/ads.astro
// Admin Advertisement Configuration Page

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db.ts';
import { getAdsSettings } from '../../../lib/settings.ts';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

const ads = await getAdsSettings(db);
---

<AdminLayout title="Advertisement Settings">
  <div class="max-w-3xl space-y-6">
    
    <div class="pb-3 border-b border-slate-200">
      <h1 class="text-2xl font-black text-slate-900 tracking-tight">Display Advertisement Settings</h1>
      <p class="text-xs text-slate-500 mt-1">Configure monetization ad networks, publisher credentials, and individual slot placements.</p>
    </div>

    <form id="ads-settings-form" class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-6 text-xs">
      
      <!-- Master Ads Toggle -->
      <div class="flex items-center justify-between pb-5 border-b border-slate-100">
        <div>
          <span class="text-sm font-bold text-slate-900 block">Enable Display Advertisements</span>
          <p class="text-slate-500 text-[11px]">Master switch to show or hide all ad units across the portal</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" name="enabled" checked={ads.enabled} class="sr-only peer" />
          <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gov-navy"></div>
        </label>
      </div>

      <!-- Network Provider -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Ad Network Provider</label>
          <select name="provider" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5">
            <option value="google_adsense" selected={ads.provider === 'google_adsense'}>Google AdSense</option>
            <option value="custom" selected={ads.provider === 'custom'}>Custom Script / Partner Network</option>
            <option value="none" selected={ads.provider === 'none'}>None</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Publisher ID / Client Tag</label>
          <input
            type="text"
            name="publisherId"
            value={ads.publisherId}
            placeholder="ca-pub-XXXXXXXXXXXXXXXX"
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 font-mono"
          />
        </div>
      </div>

      <!-- Placement Slots -->
      <div class="space-y-4 pt-4 border-t border-slate-100">
        <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Placement Slot Toggles</h2>

        <div class="flex items-center justify-between">
          <div>
            <span class="font-bold text-slate-800 block">Header Leaderboard (Top)</span>
            <span class="text-slate-400 text-[11px]">Displays below the primary navigation bar</span>
          </div>
          <input type="checkbox" name="headerAds" checked={ads.headerAds} class="rounded border-slate-300 text-gov-navy focus:ring-0 w-4 h-4" />
        </div>

        <div class="flex items-center justify-between">
          <div>
            <span class="font-bold text-slate-800 block">In-Content / Article Units</span>
            <span class="text-slate-400 text-[11px]">Displays between job notification details and official links</span>
          </div>
          <input type="checkbox" name="inContentAds" checked={ads.inContentAds} class="rounded border-slate-300 text-gov-navy focus:ring-0 w-4 h-4" />
        </div>

        <div class="flex items-center justify-between">
          <div>
            <span class="font-bold text-slate-800 block">Sidebar Rail Banner</span>
            <span class="text-slate-400 text-[11px]">Displays on large screen desktops beside job feeds</span>
          </div>
          <input type="checkbox" name="sidebarAds" checked={ads.sidebarAds} class="rounded border-slate-300 text-gov-navy focus:ring-0 w-4 h-4" />
        </div>

        <div class="flex items-center justify-between">
          <div>
            <span class="font-bold text-slate-800 block">Footer Leaderboard</span>
            <span class="text-slate-400 text-[11px]">Displays above the bottom footer</span>
          </div>
          <input type="checkbox" name="footerAds" checked={ads.footerAds} class="rounded border-slate-300 text-gov-navy focus:ring-0 w-4 h-4" />
        </div>

        <div class="flex items-center justify-between">
          <div>
            <span class="font-bold text-slate-800 block">Mobile-Specific Compact Banner</span>
            <span class="text-slate-400 text-[11px]">Displays optimized banner for mobile smartphone viewports</span>
          </div>
          <input type="checkbox" name="mobileAds" checked={ads.mobileAds} class="rounded border-slate-300 text-gov-navy focus:ring-0 w-4 h-4" />
        </div>
      </div>

      <div class="pt-5 border-t border-slate-100 flex items-center justify-between">
        <span id="ads-save-status" class="text-xs font-semibold text-emerald-600 hidden">Settings saved!</span>
        <button
          type="submit"
          class="ml-auto px-6 py-2.5 bg-gov-navy hover:bg-slate-900 text-white font-bold rounded-xl shadow-xs transition-colors"
        >
          Save Ad Settings
        </button>
      </div>

    </form>

  </div>
</AdminLayout>

<script>
  const form = document.getElementById('ads-settings-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('ads-save-status');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const payload = {
        enabled: formData.get('enabled') === 'on',
        provider: formData.get('provider'),
        publisherId: formData.get('publisherId'),
        headerAds: formData.get('headerAds') === 'on',
        inContentAds: formData.get('inContentAds') === 'on',
        sidebarAds: formData.get('sidebarAds') === 'on',
        footerAds: formData.get('footerAds') === 'on',
        mobileAds: formData.get('mobileAds') === 'on',
      };

      try {
        const res = await fetch('/api/admin/ads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = (await res.json()) as any;
        if (data.success && statusEl) {
          statusEl.classList.remove('hidden');
          setTimeout(() => statusEl.classList.add('hidden'), 3000);
        }
      } catch {}
    });
  }
</script>
