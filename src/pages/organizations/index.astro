---
// src/pages/organizations/index.astro
// Directory of All Government Recruitment Bodies, Commissions & Ministries

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getDb } from '../../lib/db.ts';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

// Fetch organizations that have published content
const organizations = (await db.query<{
  id: string;
  name: string;
  slug: string;
  code?: string;
  website_url?: string;
  logo_url?: string;
  job_count: number;
  total_count: number;
}>(`
  SELECT o.*,
         COUNT(CASE WHEN ci.type = 'job' THEN 1 END) as job_count,
         COUNT(ci.id) as total_count
  FROM organizations o
  LEFT JOIN content_items ci ON ci.organization_id = o.id AND ci.status = 'published'
  GROUP BY o.id
  ORDER BY total_count DESC, o.name ASC
`)).results;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Recruitment Organizations' },
];
---

<BaseLayout
  title="Government Recruitment Organizations & Commissions — UPSC, SSC, Railways, State PSC"
  description="Explore central and state government recruitment boards, commissions, and ministries. Access active jobs, exam schedules, admit cards, and results by organization."
>
  <div class="max-w-7xl mx-auto px-4 py-6">
    <Breadcrumbs items={breadcrumbs} />

    <div class="my-6">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        Government Recruitment Organizations & Commissions
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-3xl">
        Directory of all central ministries, constitutional bodies, defence headquarters, public sector banks, and state recruitment boards.
      </p>
    </div>

    {organizations.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {organizations.map((org) => (
          <a
            href={`/organizations/${org.slug}`}
            class="bg-white rounded-xl border border-slate-200 p-5 hover:border-gov-navy hover:shadow-md transition-all flex flex-col justify-between group"
          >
            <div>
              <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center font-bold text-slate-700 text-sm mb-3 group-hover:bg-gov-navy group-hover:text-white transition-colors">
                {org.code || org.name.slice(0, 2).toUpperCase()}
              </div>

              <h2 class="text-sm font-bold text-slate-900 group-hover:text-gov-navy line-clamp-2 leading-snug">
                {org.name}
              </h2>

              {org.website_url && (
                <p class="text-[11px] text-slate-400 mt-1 truncate">
                  {org.website_url.replace(/^https?:\/\//, '')}
                </p>
              )}
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="bg-blue-50 text-blue-800 text-[10px] font-bold px-2 py-0.5 rounded">
                {org.total_count} Active Notices
              </span>
              <span class="text-gov-saffron font-bold text-xs group-hover:translate-x-0.5 transition-transform">
                View &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <EmptyState
        title="No Organizations Found"
        message="Government organizations will appear here as notifications are published."
      />
    )}
  </div>
</BaseLayout>
