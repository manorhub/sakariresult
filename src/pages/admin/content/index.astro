---
// src/pages/admin/content/index.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db';
import { formatDate, getContentTypeLabel } from '../../../lib/utils';
import type { ContentItem } from '../../../lib/types';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

const typeFilter = Astro.url.searchParams.get('type') || '';
const statusFilter = Astro.url.searchParams.get('status') || '';

let query = `
  SELECT ci.*, c.name as category_name, o.name as organization_name
  FROM content_items ci
  LEFT JOIN categories c ON c.id = ci.category_id
  LEFT JOIN organizations o ON o.id = ci.organization_id
  WHERE 1=1
`;
const params: any[] = [];

if (typeFilter) {
  query += ' AND ci.type = ?';
  params.push(typeFilter);
}
if (statusFilter) {
  query += ' AND ci.status = ?';
  params.push(statusFilter);
}

query += ' ORDER BY ci.created_at DESC';

const items = (await db.query<ContentItem>(query, params)).results;

const contentTypes = [
  { id: 'job', label: 'Jobs' },
  { id: 'result', label: 'Results' },
  { id: 'admit_card', label: 'Admit Cards' },
  { id: 'answer_key', label: 'Answer Keys' },
  { id: 'exam', label: 'Exams' },
  { id: 'scholarship', label: 'Scholarships' },
  { id: 'syllabus', label: 'Syllabus' },
  { id: 'scheme', label: 'Schemes' },
  { id: 'update', label: 'Updates' },
];

const pendingReviewCount = items.filter(i => i.status === 'review' || i.verification_status === 'conflict_detected').length;
---

<AdminLayout title="Content Management System" subtitle="Manage government notifications, jobs, results, admit cards, and notices." activeNav="/admin/content">
  
  <!-- Filters and Action Bar -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    
    <!-- Filter Pills -->
    <div class="flex items-center space-x-2 overflow-x-auto pb-1 text-xs">
      <a
        href="/admin/content"
        class={`px-3 py-1.5 rounded-lg font-semibold transition-colors ${
          !typeFilter ? 'bg-blue-600 text-white' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50'
        }`}
      >
        All ({items.length})
      </a>
      {contentTypes.map((t) => {
        const isActive = typeFilter === t.id;
        return (
          <a
            href={`/admin/content?type=${t.id}${statusFilter ? `&status=${statusFilter}` : ''}`}
            class={`whitespace-nowrap px-3 py-1.5 rounded-lg font-semibold transition-colors ${
              isActive ? 'bg-blue-600 text-white' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50'
            }`}
          >
            {t.label}
          </a>
        );
      })}
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center space-x-2 self-start md:self-auto">
      {pendingReviewCount > 0 && (
        <a
          href="/admin/content/review"
          class="inline-flex items-center space-x-1.5 px-3 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors"
        >
          <span>Review Queue ({pendingReviewCount})</span>
        </a>
      )}
      <a
        href="/admin/content/new"
        class="inline-flex items-center space-x-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors whitespace-nowrap"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>+ Create Content</span>
      </a>
    </div>

  </div>

  <!-- Content Table -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-600">
        <thead class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
          <tr>
            <th class="px-6 py-3.5">Title & Organization</th>
            <th class="px-6 py-3.5">Type</th>
            <th class="px-6 py-3.5">AI & Quality</th>
            <th class="px-6 py-3.5">Status</th>
            <th class="px-6 py-3.5">Published / Created</th>
            <th class="px-6 py-3.5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {items.length === 0 ? (
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-slate-400">
                No content items found. Click "+ Create Content" to publish a new notification.
              </td>
            </tr>
          ) : (
            items.map((item) => {
              const badge = getContentTypeLabel(item.type);
              const score = item.quality_score || 0;
              const hasConflict = item.verification_status === 'conflict_detected' || item.ai_status === 'verification_required';
              return (
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="px-6 py-4">
                    <div class="max-w-md">
                      <a href={`/admin/content/${item.id}`} class="font-bold text-slate-900 hover:text-blue-600 line-clamp-1">
                        {item.title}
                      </a>
                      <div class="flex items-center space-x-2 text-[11px] text-slate-400 mt-0.5 font-mono">
                        <span>/{item.slug}</span>
                        {item.organization_name && (
                          <span class="text-slate-600 font-sans font-medium bg-slate-100 px-1.5 py-0.2 rounded">
                            {item.organization_name}
                          </span>
                        )}
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold border ${badge.bg}`}>
                      {badge.label}
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex items-center space-x-2">
                      <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ${
                        hasConflict ? 'bg-rose-50 text-rose-700 border border-rose-200' :
                        item.verification_status === 'verified' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                        'bg-slate-100 text-slate-600 border border-slate-200'
                      }`}>
                        {hasConflict ? 'Conflict' : item.verification_status === 'verified' ? 'Verified' : 'Draft'}
                      </span>
                      {score > 0 && (
                        <span class={`text-[10px] font-mono font-bold ${score >= 90 ? 'text-emerald-600' : score >= 75 ? 'text-amber-600' : 'text-rose-600'}`}>
                          {score}/100
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
                      item.status === 'published' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                      item.status === 'review' ? 'bg-blue-50 text-blue-700 border border-blue-200' :
                      item.status === 'archived' ? 'bg-slate-100 text-slate-500 border border-slate-200' :
                      'bg-amber-50 text-amber-700 border border-amber-200'
                    }`}>
                      {item.status}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-slate-400">
                    {formatDate(item.published_at || item.created_at)}
                  </td>
                  <td class="px-6 py-4 text-right space-x-2 whitespace-nowrap">
                    <a
                      href={`/admin/content/${item.id}`}
                      class="px-2.5 py-1 text-xs font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 rounded-md transition-colors"
                    >
                      Edit
                    </a>
                    <button
                      data-id={item.id}
                      data-title={item.title}
                      class="btn-delete-content px-2.5 py-1 text-xs font-semibold text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 rounded-md transition-colors"
                    >
                      Delete
                    </button>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
  </div>

</AdminLayout>

<script>
  document.querySelectorAll('.btn-delete-content').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const title = btn.getAttribute('data-title');
      if (!confirm(`Are you sure you want to delete "${title}"?`)) return;

      try {
        const res = await fetch(`/api/admin/content/${id}`, { method: 'DELETE' });
        const data = (await res.json()) as any;
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          alert(data.error || 'Failed to delete content.');
        }
      } catch (err) {
        alert('Network error while deleting content.');
      }
    });
  });
</script>
