# ==============================================================================
# SARKARI INFO — PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env or configure directly in Cloudflare Workers Dashboard.
# NEVER COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# 1. ADMIN AUTHENTICATION & SECURITY
# Minimum 32 characters cryptographically random secret string used for HMAC session validation.
ADMIN_JWT_SECRET="your-32-char-min-cryptographic-jwt-secret-key-here"

# 2. CLOUDFLARE INFRASTRUCTURE BINDINGS (Configured in wrangler.toml / Cloudflare Dashboard)
# Database: Cloudflare D1
# CLOUDFLARE_DATABASE_ID="your-d1-database-uuid"
# Storage: Cloudflare R2
# CLOUDFLARE_R2_BUCKET_NAME="sarkari-documents-prod"

# 3. DEEPSEEK AI ENGINE
# Primary DeepSeek API Key for factual entity extraction, verification & content generation
DEEPSEEK_API_KEY="sk-your-deepseek-api-key-here"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# 4. TRANSACTIONAL EMAIL PROVIDER (Optional / Configurable)
# Provider choices: 'resend', 'sendgrid', 'postmark', 'webhook', 'mock'
EMAIL_PROVIDER="resend"
EMAIL_API_KEY="re_your_transactional_email_key_here"
EMAIL_FROM_ADDRESS="alerts@sarkariinfo.in"
EMAIL_FROM_NAME="Sarkari Info Alerts"
# EMAIL_WEBHOOK_URL="https://your-webhook-endpoint.com/send"

# 5. MONETIZATION & ADVERTISING (Optional / Configurable)
# Ad Network choices: 'google_adsense', 'custom', 'none'
ADS_ENABLED="true"
ADS_PROVIDER="google_adsense"
ADS_PUBLISHER_ID="ca-pub-0000000000000000"

# 6. PAYMENT PROVIDER (Optional / Configurable for Premium Alerts)
# Provider choices: 'razorpay', 'stripe', 'cashfree', 'none'
PAYMENT_PROVIDER="none"
# PAYMENT_KEY_ID="rzp_live_your_key_id"
# PAYMENT_KEY_SECRET="your_payment_key_secret"
# PAYMENT_WEBHOOK_SECRET="your_webhook_signing_secret"

# 7. PLATFORM GLOBAL DEFAULTS
SITE_URL="https://sarkariinfo.in"
SITE_NAME="Sarkari Info"
DEFAULT_CURRENCY="INR"
DEFAULT_LANGUAGE="en"
