---
// src/pages/states/index.astro
// Directory of Indian States and Union Territories with Active Government Jobs

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { INDIAN_STATES } from '../../lib/public_queries.ts';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'State Government Jobs' },
];
---

<BaseLayout
  title="State Government Jobs 2026 — Recruitment by State & Union Territory"
  description="Explore state public service commission (PSC) recruitment, police vacancies, teacher eligibility tests, and district-level government job opportunities by state."
>
  <div class="max-w-7xl mx-auto px-4 py-6">
    <Breadcrumbs items={breadcrumbs} />

    <div class="my-6">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        State Government Jobs & Recruitment 2026
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-3xl">
        Select your state or union territory to view state civil services, police constable/SI, subordinate selection boards, and teaching vacancies.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3.5">
      {INDIAN_STATES.map((state) => (
        <a
          href={`/states/${state.slug}`}
          class="bg-white rounded-xl border border-slate-200 p-4 hover:border-gov-navy hover:bg-slate-50 hover:shadow-xs transition-all flex flex-col items-center text-center group"
        >
          <div class="w-10 h-10 rounded-full bg-amber-50 text-amber-800 flex items-center justify-center font-bold text-sm mb-2 group-hover:bg-gov-navy group-hover:text-white transition-colors">
            📍
          </div>
          <h2 class="text-xs font-bold text-slate-800 group-hover:text-gov-navy">
            {state.name}
          </h2>
          <span class="text-[10px] text-gov-saffron font-semibold mt-1">
            View Jobs &rarr;
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
