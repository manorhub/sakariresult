---
// src/components/ads/AdSlotContent.astro
// In-Article / Content Ad Placement

import { getDb } from '../../lib/db.ts';
import { evaluateAdDisplay } from '../../lib/monetization/ads.ts';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const isDev = import.meta.env.DEV;
let adState = { showAd: false, isDev: false, provider: 'none', publisherId: '', slotType: 'content' };

if (d1) {
  const db = getDb(d1);
  adState = await evaluateAdDisplay(db, 'content', isDev);
} else if (isDev) {
  adState = { showAd: true, isDev: true, provider: 'mock', publisherId: 'dev-mode', slotType: 'content' };
}
---

{adState.showAd && (
  <div class="my-6 p-3 bg-slate-50 border border-slate-200 rounded-xl text-center" aria-label="Sponsored In-Content Advertisement">
    <span class="text-[9px] font-extrabold uppercase tracking-widest text-slate-400 block mb-1">
      ADVERTISEMENT
    </span>
    {adState.isDev ? (
      <div class="w-full h-24 bg-slate-200/90 border border-dashed border-slate-300 rounded-lg flex items-center justify-center text-xs font-semibold text-slate-500">
        In-Content Ad Slot (Responsive / Banner)
      </div>
    ) : (
      <div class="ad-slot-container min-h-[90px] w-full" data-ad-slot="content" data-publisher={adState.publisherId}>
        <!-- Provider Script Integration Container -->
      </div>
    )}
  </div>
)}
