---
// src/pages/answer-key/[slug].astro
// Single Answer Key Page with Download Link, Objection Dates, and Solution PDF

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ImportantLinks from '../../components/ImportantLinks.astro';
import SourceBox from '../../components/SourceBox.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import AdminPreviewBanner from '../../components/AdminPreviewBanner.astro';
import { getDb } from '../../lib/db.ts';
import { renderMarkdownToHtml } from '../../lib/markdown.ts';
import { getContentItemBySlug, getRelatedContent } from '../../lib/public_queries.ts';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/answer-key');

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

const isPreviewQuery = Astro.url.searchParams.get('preview') === 'true';
const { item, isPreview } = await getContentItemBySlug(db, 'answer_key', slug, { allowPreview: isPreviewQuery });

if (!item) {
  return Astro.redirect('/404');
}

let extractedData: any = {};
let faqs: any[] = [];
try { if (item.extracted_data_json) extractedData = JSON.parse(item.extracted_data_json); } catch {}
try { if (item.faq_json) faqs = JSON.parse(item.faq_json); } catch {}

const relatedItems = await getRelatedContent(db, item, 6);

const actionLinks = [
  { label: 'Download Answer Key & Response Sheet (PDF)', url: item.answer_key_url || extractedData.answer_key_url, isPrimary: true, type: 'answer_key' as const },
  { label: 'Submit Question Objection / Challenge Portal', url: extractedData.objection_url, type: 'answer_key' as const },
  { label: 'Official Examination Portal', url: item.organization_website || extractedData.official_website_url, type: 'official_site' as const },
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Answer Key', href: '/answer-key' },
  { label: item.title },
];
---

<BaseLayout
  title={item.seo_title || `${item.title} — Download Answer Key & Objection Link`}
  description={item.meta_description || item.excerpt || `Download ${item.title} solution PDF, response sheet, and check objection submission window.`}
  canonicalUrl={item.canonical_url || `${Astro.site ? Astro.site.toString() : 'https://sarkariinfo.in'}/answer-key/${item.slug}`}
>
  {isPreview && <AdminPreviewBanner status={item.status} itemId={item.id} />}

  <div class="max-w-5xl mx-auto px-4 py-6">
    <Breadcrumbs items={breadcrumbs} />

    <article class="mt-4 bg-white rounded-2xl border border-slate-200 p-5 sm:p-8 shadow-xs">
      
      <header class="border-b border-slate-200 pb-6 mb-6">
        <div class="flex items-center space-x-2 mb-2 flex-wrap gap-y-1">
          <span class="bg-purple-600 text-white text-[11px] font-bold px-2.5 py-0.5 rounded">
            Answer Key
          </span>
          {item.organization_name && (
            <span class="bg-slate-100 text-slate-700 text-[11px] font-semibold px-2.5 py-0.5 rounded border border-slate-200">
              {item.organization_name}
            </span>
          )}
          <span class="bg-purple-100 text-purple-900 text-[11px] font-bold px-2.5 py-0.5 rounded">
            Official Key Live
          </span>
        </div>

        <h1 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight">
          {item.title}
        </h1>

        {item.update_summary && (
          <div class="mt-3 p-3 bg-amber-50 rounded-xl border border-amber-200 text-xs text-amber-950 flex items-start space-x-2">
            <span class="bg-amber-600 text-white font-black text-[10px] px-1.5 py-0.5 rounded shrink-0">NOTICE</span>
            <p class="font-medium">{item.update_summary}</p>
          </div>
        )}
      </header>

      <!-- Key Details -->
      <div class="bg-slate-50 rounded-xl border border-slate-200 p-4 mb-6 text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <span class="text-slate-500 block text-[11px]">Examination Authority:</span>
            <strong class="text-slate-900">{item.organization_name || 'Official Board'}</strong>
          </div>
          <div>
            <span class="text-slate-500 block text-[11px]">Answer Key Date:</span>
            <strong class="text-purple-800">{extractedData.answer_key_date || item.published_at || 'Released'}</strong>
          </div>
          <div>
            <span class="text-slate-500 block text-[11px]">Objection Window:</span>
            <strong class="text-rose-700">{extractedData.objection_start ? `${extractedData.objection_start} to ${extractedData.objection_end || 'End Date'}` : 'See Official Notice'}</strong>
          </div>
        </div>
      </div>

      <ImportantLinks links={actionLinks} title="Answer Key & Solution Direct Links" />

      {item.article_content ? (
        <div class="prose prose-sm sm:prose max-w-none text-slate-800 leading-relaxed font-sans mt-8 divide-y-0 space-y-6">
          <div class="article-markdown-body" set:html={renderMarkdownToHtml(item.article_content)} />
        </div>
      ) : (
        <div class="text-xs sm:text-sm text-slate-700 space-y-3 mt-6">
          <h2 class="text-base font-bold text-slate-900">How to Challenge / Raise Objection:</h2>
          <ol class="list-decimal pl-5 space-y-1.5 leading-relaxed">
            <li>Log in using your Roll Number and Password on the objection link above.</li>
            <li>Select the Question Number and Master Key Answer you wish to challenge.</li>
            <li>Upload documentary proof/reference supporting your proposed correct answer.</li>
            <li>Pay the prescribed objection processing fee per question (if applicable) and submit.</li>
          </ol>
        </div>
      )}

      {faqs.length > 0 && (
        <FAQAccordion faqs={faqs} title={`Frequently Asked Questions: ${item.title}`} />
      )}

      <SourceBox
        sourceName={item.source_name || item.organization_name}
        sourceBaseUrl={item.source_base_url || item.organization_website}
        officialNotificationUrl={item.official_notification_url || extractedData.official_notification_url}
        publishedAt={item.published_at}
        updatedAt={item.updated_at}
      />

    </article>

    {relatedItems.length > 0 && (
      <RelatedContent items={relatedItems} title="Related Answer Keys & Examination Results" />
    )}

  </div>
</BaseLayout>
