---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-gov-navy text-slate-300 border-t-4 border-gov-saffron mt-auto">
  <div class="max-w-7xl mx-auto px-4 py-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      
      <!-- Brand & Mission -->
      <div class="md:col-span-1 space-y-3">
        <div class="flex items-center space-x-2">
          <div class="w-8 h-8 rounded bg-gradient-to-tr from-gov-saffron to-amber-500 flex items-center justify-center text-white font-black text-sm tracking-tighter">RSE</div>
          <span class="text-xl font-bold text-white tracking-tight">
            REAL<span class="text-gov-saffron">SARKARI</span><span class="text-amber-400">EXAM</span>
          </span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          Fast, verified, and timely notifications for Indian Central & State Government Jobs, Exam Results, Admit Cards, Answer Keys, and Welfare Schemes.
        </p>
        <div class="pt-1 flex flex-wrap gap-2 text-[11px]">
          <a href="/organizations" class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300">All Organizations</a>
          <a href="/states" class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300">State Portals</a>
          <a href="/search" class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300">Search Hub</a>
        </div>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3 pb-1 border-b border-slate-700">
          Core Portals
        </h3>
        <ul class="space-y-1.5 text-xs">
          <li><a href="/jobs" class="hover:text-amber-400 transition-colors">Government Jobs 2026</a></li>
          <li><a href="/results" class="hover:text-amber-400 transition-colors">Exam Results & Scorecards</a></li>
          <li><a href="/admit-card" class="hover:text-amber-400 transition-colors">Admit Cards / Hall Tickets</a></li>
          <li><a href="/answer-key" class="hover:text-amber-400 transition-colors">Answer Keys & Objections</a></li>
          <li><a href="/exams" class="hover:text-amber-400 transition-colors">Upcoming Exam Calendar</a></li>
          <li><a href="/scholarships" class="hover:text-amber-400 transition-colors">National Scholarships</a></li>
          <li><a href="/syllabus" class="hover:text-amber-400 transition-colors">Syllabus & Exam Pattern</a></li>
          <li><a href="/schemes" class="hover:text-amber-400 transition-colors">Government Schemes</a></li>
        </ul>
      </div>

      <!-- Popular Segments -->
      <div>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3 pb-1 border-b border-slate-700">
          Popular Sectors
        </h3>
        <ul class="space-y-1.5 text-xs">
          <li><a href="/search?q=SSC" class="hover:text-amber-400 transition-colors">Staff Selection Commission (SSC)</a></li>
          <li><a href="/search?q=Railway" class="hover:text-amber-400 transition-colors">Railway Recruitment Board (RRB)</a></li>
          <li><a href="/search?q=Banking" class="hover:text-amber-400 transition-colors">Banking & IBPS Careers</a></li>
          <li><a href="/search?q=Defence" class="hover:text-amber-400 transition-colors">Defence (NDA, CDS, Army, Navy)</a></li>
          <li><a href="/search?q=Teaching" class="hover:text-amber-400 transition-colors">Teaching & TET Vacancies</a></li>
          <li><a href="/search?q=Police" class="hover:text-amber-400 transition-colors">Police Constable & SI Posts</a></li>
          <li><a href="/search?q=UPSC" class="hover:text-amber-400 transition-colors">UPSC Civil Services & Engineering</a></li>
        </ul>
      </div>

      <!-- Information, Legal & Compliance -->
      <div>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3 pb-1 border-b border-slate-700">
          Information & Editorial
        </h3>
        <ul class="space-y-1.5 text-xs">
          <li><a href="/about" class="hover:text-amber-400 transition-colors">About RealSarkariExam</a></li>
          <li><a href="/contact" class="hover:text-amber-400 transition-colors">Contact & Support</a></li>
          <li><a href="/disclaimer" class="hover:text-amber-400 transition-colors">Disclaimer Notice</a></li>
          <li><a href="/privacy-policy" class="hover:text-amber-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-amber-400 transition-colors">Terms of Service</a></li>
          <li><a href="/editorial-policy" class="hover:text-amber-400 transition-colors font-medium text-amber-300">Editorial Policy</a></li>
          <li><a href="/correction-policy" class="hover:text-amber-400 transition-colors font-medium text-amber-300">Fact-Checking & Corrections</a></li>
          <li><a href="/admin/login" class="hover:text-slate-400 transition-colors text-slate-500">Staff Login</a></li>
        </ul>
      </div>

    </div>

    <!-- Official Non-Affiliation Disclaimer -->
    <div class="bg-slate-900/90 rounded-lg p-4 text-[11px] text-slate-300 leading-relaxed border border-slate-800 space-y-1.5">
      <div class="font-bold text-amber-400 flex items-center space-x-1.5">
        <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Important Official Notice & Disclaimer:</span>
      </div>
      <p>
        <strong>RealSarkariExam</strong> is an independent educational and public informational platform. We are <strong>NOT</strong> affiliated, authorized, endorsed by, or in any way officially connected with any central or state government ministry, department, commission (such as UPSC, SSC, NTA, RRB, IBPS), or examination authority. All recruitment notifications, admit cards, answer keys, and results published here are curated strictly from official government gazettes, websites, and press releases for educational convenience. Candidates must always verify details with official notification brochures before taking action.
      </p>
    </div>

    <!-- Copyright Bar -->
    <div class="mt-6 pt-4 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-2">
      <p>&copy; {currentYear} RealSarkariExam. Independent Public Information Platform.</p>
      <div class="flex flex-wrap gap-4 text-slate-400">
        <a href="/privacy-policy" class="hover:underline">Privacy</a>
        <a href="/terms" class="hover:underline">Terms</a>
        <a href="/disclaimer" class="hover:underline">Disclaimer</a>
        <a href="/editorial-policy" class="hover:underline">Editorial</a>
        <a href="/correction-policy" class="hover:underline">Corrections</a>
        <a href="/contact" class="hover:underline">Contact</a>
      </div>
    </div>
  </div>
</footer>
