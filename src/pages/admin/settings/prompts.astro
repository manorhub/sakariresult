---
// src/pages/admin/settings/prompts.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db';
import { DEFAULT_PROMPTS } from '../../../lib/ai/prompts';
import type { AIPrompt } from '../../../lib/types';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

const dbPrompts = (await db.query<AIPrompt>('SELECT * FROM ai_prompts')).results;
const dbMap = new Map(dbPrompts.map((p) => [p.prompt_name, p]));

const promptCards = [
  {
    id: 'classification',
    title: '1. Content Classification',
    desc: 'Categorizes crawled source into Government Job, Result, Admit Card, Answer Key, etc.',
    vars: ['{{SOURCE_CONTENT}}'],
  },
  {
    id: 'extraction',
    title: '2. Structured Data Extraction',
    desc: 'Extracts normalized fields, dates, vacancies, eligibility, and verbatim evidence snippets.',
    vars: ['{{SOURCE_CONTENT}}', '{{CONTENT_TYPE}}'],
  },
  {
    id: 'verification',
    title: '3. Factual Consistency & Fact-Check',
    desc: 'Compares extracted figures and dates against raw source text to detect hallucinations.',
    vars: ['{{EXTRACTED_DATA}}', '{{SOURCE_CONTENT}}'],
  },
  {
    id: 'article_generation',
    title: '4. Public Article Generation',
    desc: 'Generates original, copyright-safe, structured Markdown article with headings and tables.',
    vars: ['{{VERIFIED_FACTS}}', '{{SOURCE_URL}}', '{{ORGANIZATION}}'],
  },
  {
    id: 'seo_generation',
    title: '5. SEO & OpenGraph Generation',
    desc: 'Generates keyword-rich, clickbait-free meta titles, descriptions, and excerpts.',
    vars: ['{{VERIFIED_FACTS}}'],
  },
  {
    id: 'faq_generation',
    title: '6. Verified FAQ Generation',
    desc: 'Produces factual Q&A exclusively from confirmed fields without inventing data.',
    vars: ['{{VERIFIED_FACTS}}'],
  },
  {
    id: 'update_summary',
    title: '7. Update & Corrigendum Summary',
    desc: 'Detects date extensions or vacancy revisions between previous and new extractions.',
    vars: ['{{OLD_DATA}}', '{{NEW_DATA}}'],
  },
];
---

<AdminLayout title="AI Prompt Manager" subtitle="Manage and customize system instructions and prompt templates for all DeepSeek operations." activeNav="/admin/settings/prompts">
  
  <div class="max-w-5xl space-y-6">

    <!-- Top Action Bar -->
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <a href="/admin/settings/ai" class="text-xs text-blue-600 hover:underline flex items-center space-x-1 font-semibold">
          <span>&larr; Back to AI Settings</span>
        </a>
      </div>
      <div class="text-xs text-slate-500">
        All templates enforce <strong>Prompt Injection Defense</strong> rules.
      </div>
    </div>

    <!-- Prompts List -->
    <div class="space-y-6">
      {promptCards.map((card) => {
        const fallback = (DEFAULT_PROMPTS as any)[card.id] || { system: '', user: '' };
        const saved = dbMap.get(card.id);
        const currentSystem = saved?.system_prompt || fallback.system;
        const currentUser = saved?.prompt_text || fallback.user;
        const version = saved?.version || 1;
        const isCustom = !!saved;

        return (
          <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden" id={`prompt-card-${card.id}`}>
            <!-- Header -->
            <div class="p-5 bg-slate-50 border-b border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
              <div>
                <div class="flex items-center space-x-2">
                  <h3 class="text-sm font-bold text-slate-900">{card.title}</h3>
                  <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-slate-200 text-slate-700 font-mono">
                    v{version}
                  </span>
                  {isCustom && (
                    <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-blue-100 text-blue-800">
                      Customized
                    </span>
                  )}
                </div>
                <p class="text-xs text-slate-500 mt-0.5">{card.desc}</p>
              </div>

              <!-- Available Template Placeholders -->
              <div class="flex items-center space-x-1.5 flex-wrap">
                <span class="text-[10px] text-slate-400 font-semibold uppercase">Vars:</span>
                {card.vars.map((v) => (
                  <span class="text-[10px] bg-slate-100 border border-slate-300 px-1.5 py-0.5 rounded font-mono text-slate-700">
                    {v}
                  </span>
                ))}
              </div>
            </div>

            <!-- Form Body -->
            <div class="p-6 space-y-4">
              <!-- System Prompt -->
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">System Instructions (Role & Guardrails)</label>
                <textarea
                  id={`system_${card.id}`}
                  rows="4"
                  class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 font-mono text-slate-800 bg-slate-50"
                >{currentSystem}</textarea>
              </div>

              <!-- User Prompt Template -->
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">User Prompt Template</label>
                <textarea
                  id={`user_${card.id}`}
                  rows="4"
                  class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 font-mono text-slate-800"
                >{currentUser}</textarea>
              </div>

              <!-- Action Buttons -->
              <div class="flex items-center justify-between pt-2">
                <button
                  type="button"
                  data-name={card.id}
                  class="btn-reset-prompt text-xs font-semibold text-rose-600 hover:text-rose-800 hover:underline"
                >
                  Reset to Safe Default
                </button>

                <button
                  type="button"
                  data-name={card.id}
                  class="btn-save-prompt px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg transition-colors shadow-xs"
                >
                  Save & Increment Version
                </button>
              </div>
            </div>
          </div>
        );
      })}
    </div>

  </div>

</AdminLayout>

<script>
  // Save custom prompt
  document.querySelectorAll('.btn-save-prompt').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const name = btn.getAttribute('data-name');
      if (!name) return;

      const systemInput = document.getElementById(`system_${name}`) as HTMLTextAreaElement;
      const userInput = document.getElementById(`user_${name}`) as HTMLTextAreaElement;

      const payload = {
        prompt_name: name,
        system_prompt: systemInput?.value.trim(),
        prompt_text: userInput?.value.trim(),
      };

      try {
        const res = await fetch('/api/admin/ai/prompts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = (await res.json()) as any;
        if (res.ok && data.success) {
          alert(`Prompt "${name}" saved successfully!`);
          window.location.reload();
        } else {
          alert(data.error || 'Failed to save prompt.');
        }
      } catch (err) {
        alert('Network error while saving prompt.');
      }
    });
  });

  // Reset prompt to default
  document.querySelectorAll('.btn-reset-prompt').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const name = btn.getAttribute('data-name');
      if (!name || !confirm(`Reset prompt "${name}" back to hardcoded default?`)) return;

      try {
        const res = await fetch('/api/admin/ai/prompts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prompt_name: name, reset_to_default: true }),
        });
        const data = (await res.json()) as any;
        if (res.ok && data.success) {
          alert(`Prompt "${name}" reset to default.`);
          window.location.reload();
        } else {
          alert(data.error || 'Failed to reset prompt.');
        }
      } catch (err) {
        alert('Network error while resetting prompt.');
      }
    });
  });
</script>
