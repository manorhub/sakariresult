---
// src/components/ads/AdSlotFooter.astro
// Bottom / Footer Leaderboard Ad Placement

import { getDb } from '../../lib/db.ts';
import { evaluateAdDisplay } from '../../lib/monetization/ads.ts';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const isDev = import.meta.env.DEV;
let adState = { showAd: false, isDev: false, provider: 'none', publisherId: '', slotType: 'footer' };

if (d1) {
  const db = getDb(d1);
  adState = await evaluateAdDisplay(db, 'footer', isDev);
} else if (isDev) {
  adState = { showAd: true, isDev: true, provider: 'mock', publisherId: 'dev-mode', slotType: 'footer' };
}
---

{adState.showAd && (
  <div class="w-full bg-slate-50 border-t border-slate-200 py-4 px-4 text-center mt-8" aria-label="Footer Advertisement">
    <div class="max-w-4xl mx-auto flex flex-col items-center justify-center">
      <span class="text-[9px] font-extrabold uppercase tracking-widest text-slate-400 mb-1">
        ADVERTISEMENT
      </span>
      {adState.isDev ? (
        <div class="w-full h-20 bg-slate-200/90 border border-dashed border-slate-300 rounded-lg flex items-center justify-center text-xs font-semibold text-slate-500">
          Footer Banner Ad (728x90 / 970x90 / Responsive)
        </div>
      ) : (
        <div class="ad-slot-container min-h-[60px] w-full" data-ad-slot="footer" data-publisher={adState.publisherId}>
          <!-- Provider Script Integration Container -->
        </div>
      )}
    </div>
  </div>
)}
