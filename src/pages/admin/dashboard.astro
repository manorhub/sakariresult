---
// src/pages/admin/dashboard.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatCard from '../../components/admin/StatCard.astro';
import { getDb } from '../../lib/db';
import { formatDate, getContentTypeLabel } from '../../lib/utils';
import { getDueSources } from '../../lib/crawler/scheduler';
import type { ContentItem, Source, CrawlLog } from '../../lib/types';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

// Fetch Metrics from D1
const jobCount = (await db.first<{ count: number }>('SELECT COUNT(*) as count FROM content_items WHERE type = "job"'))?.count || 0;
const resultCount = (await db.first<{ count: number }>('SELECT COUNT(*) as count FROM content_items WHERE type = "result"'))?.count || 0;
const admitCardCount = (await db.first<{ count: number }>('SELECT COUNT(*) as count FROM content_items WHERE type = "admit_card"'))?.count || 0;

const draftCount = (await db.first<{ count: number }>('SELECT COUNT(*) as count FROM content_items WHERE status = "draft"'))?.count || 0;
const publishedCount = (await db.first<{ count: number }>('SELECT COUNT(*) as count FROM content_items WHERE status = "published"'))?.count || 0;

const allSources = (await db.query<Source>('SELECT * FROM sources')).results;
const activeSourceCount = allSources.filter(s => s.status === 'active').length;
const sourcesDueCount = getDueSources(allSources, 50).length;

// Automation Today's Metrics
const todayStats = (await db.first<{
  checked: number;
  new_pages: number;
  updated_pages: number;
  errors: number;
  docs: number;
}>(`
  SELECT 
    COUNT(id) as checked,
    COALESCE(SUM(new_items), 0) as new_pages,
    COALESCE(SUM(updated_items), 0) as updated_pages,
    COALESCE(SUM(errors), 0) as errors,
    COALESCE(SUM(documents_downloaded), 0) as docs
  FROM crawl_logs
  WHERE started_at >= date('now', 'start of day')
`)) || { checked: 0, new_pages: 0, updated_pages: 0, errors: 0, docs: 0 };

const lastCrawlLog = await db.first<CrawlLog>('SELECT * FROM crawl_logs ORDER BY started_at DESC LIMIT 1');

// Phase 3 AI Pipeline Metrics
const aiTodayStats = (await db.first<{
  requests: number;
  total_tokens: number;
  success_count: number;
  failed_count: number;
  avg_duration_ms: number;
}>(`
  SELECT
    COUNT(id) as requests,
    COALESCE(SUM(total_tokens), 0) as total_tokens,
    COALESCE(SUM(CASE WHEN status = 'success' THEN 1 ELSE 0 END), 0) as success_count,
    COALESCE(SUM(CASE WHEN status = 'failed' THEN 1 ELSE 0 END), 0) as failed_count,
    COALESCE(AVG(duration_ms), 0) as avg_duration_ms
  FROM ai_generations
  WHERE created_at >= date('now', 'start of day')
`)) || { requests: 0, total_tokens: 0, success_count: 0, failed_count: 0, avg_duration_ms: 0 };

const aiMonthRequests = (await db.first<{ count: number }>(`
  SELECT COUNT(id) as count FROM ai_generations WHERE created_at >= date('now', 'start of month')
`))?.count || 0;

const pendingReviewCount = (await db.first<{ count: number }>(`
  SELECT COUNT(id) as count FROM content_items
  WHERE status = 'review' OR verification_status = 'conflict_detected' OR ai_status = 'verification_required'
`))?.count || 0;

const conflictCount = (await db.first<{ count: number }>(`
  SELECT COUNT(id) as count FROM content_items WHERE verification_status = 'conflict_detected'
`))?.count || 0;

// Fetch Recent Content Activity
const recentContent = (await db.query<ContentItem>(`
  SELECT ci.*, c.name as category_name, o.name as organization_name
  FROM content_items ci
  LEFT JOIN categories c ON c.id = ci.category_id
  LEFT JOIN organizations o ON o.id = ci.organization_id
  ORDER BY ci.updated_at DESC
  LIMIT 6
`)).results;
---

<AdminLayout title="Admin Dashboard" subtitle="Overview of government recruitment content, active sources, and DeepSeek AI engine metrics." activeNav="/admin/dashboard">
  
  <!-- Top Stat Cards Grid -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <StatCard title="Total Jobs" value={jobCount} color="blue">
      <svg slot="icon" class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
    </StatCard>

    <StatCard title="Results" value={resultCount} color="emerald">
      <svg slot="icon" class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </StatCard>

    <StatCard title="Admit Cards" value={admitCardCount} color="amber">
      <svg slot="icon" class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
      </svg>
    </StatCard>

    <StatCard title="Pending Review" value={pendingReviewCount} color={pendingReviewCount > 0 ? "rose" : "purple"}>
      <svg slot="icon" class="w-5 h-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    </StatCard>
  </div>

  <!-- Phase 3 DeepSeek AI Engine Status Panel (Section 28) -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-6 mb-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-4 border-b border-slate-100 gap-2 mb-4">
      <div class="flex items-center space-x-2">
        <div class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-ping"></div>
        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">DeepSeek AI Processing & Verification Metrics</h2>
      </div>
      <div class="flex items-center space-x-3 text-xs text-slate-500">
        <span>Model: <strong>deepseek-chat</strong></span>
        <span>•</span>
        <button
          id="btn-auto-publish-all"
          class="px-3 py-1 bg-gov-saffron hover:bg-orange-600 text-white font-bold rounded-lg shadow-xs transition-colors flex items-center space-x-1 cursor-pointer"
        >
          <span>⚡ Auto-Publish All Posts</span>
        </button>
        <span>•</span>
        <a href="/admin/content/review" class="text-blue-600 font-bold hover:underline">
          Review Queue ({pendingReviewCount}) &rarr;
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-6 gap-4 text-center">
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
        <span class="block text-slate-400 text-[10px] uppercase font-bold">AI Calls Today</span>
        <span class="text-lg font-black text-slate-900">{aiTodayStats.requests}</span>
      </div>
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
        <span class="block text-slate-400 text-[10px] uppercase font-bold">Monthly Calls</span>
        <span class="text-lg font-black text-blue-600">{aiMonthRequests}</span>
      </div>
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
        <span class="block text-slate-400 text-[10px] uppercase font-bold">Tokens Today</span>
        <span class="text-lg font-black text-emerald-600">{aiTodayStats.total_tokens.toLocaleString()}</span>
      </div>
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
        <span class="block text-slate-400 text-[10px] uppercase font-bold">Avg Latency</span>
        <span class="text-lg font-black text-purple-600">{Math.round(aiTodayStats.avg_duration_ms)}ms</span>
      </div>
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
        <span class="block text-slate-400 text-[10px] uppercase font-bold">Conflicts Found</span>
        <span class={`text-lg font-black ${conflictCount > 0 ? 'text-rose-600' : 'text-slate-400'}`}>{conflictCount}</span>
      </div>
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
        <span class="block text-slate-400 text-[10px] uppercase font-bold">Requires Review</span>
        <span class={`text-lg font-black ${pendingReviewCount > 0 ? 'text-amber-600' : 'text-slate-400'}`}>{pendingReviewCount}</span>
      </div>
    </div>
  </div>

  <!-- Automation Status Panel (Phase 2) -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-xs p-6 mb-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-4 border-b border-slate-100 gap-2 mb-4">
      <div class="flex items-center space-x-2">
        <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></div>
        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Automation & Crawler Engine Status</h2>
      </div>
      <div class="flex items-center space-x-3 text-xs text-slate-500">
        <span>Cron: <strong>*/15 * * * *</strong> (Active)</span>
        <span>•</span>
        <span>Last Run: <strong>{lastCrawlLog ? new Date(lastCrawlLog.started_at).toLocaleTimeString('en-IN') : 'None'}</strong></span>
        <a href="/admin/logs/crawls" class="text-blue-600 font-bold hover:underline">View Logs &rarr;</a>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-6 gap-4 text-center">
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
        <span class="block text-slate-400 text-[10px] uppercase font-bold">Sources Due</span>
        <span class="text-lg font-black text-slate-900">{sourcesDueCount}</span>
      </div>
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
        <span class="block text-slate-400 text-[10px] uppercase font-bold">Checked Today</span>
        <span class="text-lg font-black text-blue-600">{todayStats.checked}</span>
      </div>
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
        <span class="block text-slate-400 text-[10px] uppercase font-bold">New Pages</span>
        <span class="text-lg font-black text-emerald-600">+{todayStats.new_pages}</span>
      </div>
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
        <span class="block text-slate-400 text-[10px] uppercase font-bold">Updated Pages</span>
        <span class="text-lg font-black text-purple-600">~{todayStats.updated_pages}</span>
      </div>
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
        <span class="block text-slate-400 text-[10px] uppercase font-bold">PDFs Saved</span>
        <span class="text-lg font-black text-amber-600">{todayStats.docs}</span>
      </div>
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
        <span class="block text-slate-400 text-[10px] uppercase font-bold">Crawl Errors</span>
        <span class={`text-lg font-black ${todayStats.errors > 0 ? 'text-rose-600' : 'text-slate-400'}`}>{todayStats.errors}</span>
      </div>
    </div>
  </div>

  <!-- Main Content & Activity Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Recent Content (2 Columns) -->
    <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
      <div class="p-5 border-b border-slate-200 flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-900">Recent Content Items</h2>
          <p class="text-xs text-slate-500">Latest publications and drafts in the system</p>
        </div>
        <a href="/admin/content" class="text-xs font-semibold text-blue-600 hover:text-blue-700">
          View All ({publishedCount + draftCount}) &rarr;
        </a>
      </div>

      {recentContent.length === 0 ? (
        <div class="p-8 text-center text-xs text-slate-500">
          No content created yet. Click "+ Create Content" to add the first job notification.
        </div>
      ) : (
        <div class="divide-y divide-slate-100">
          {recentContent.map((item) => {
            const badge = getContentTypeLabel(item.type);
            return (
              <div class="p-4 hover:bg-slate-50 flex items-center justify-between gap-4 transition-colors">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center space-x-2 mb-1">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-bold border ${badge.bg}`}>
                      {badge.label}
                    </span>
                    <span class={`px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${
                      item.status === 'published' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-amber-50 text-amber-700 border border-amber-200'
                    }`}>
                      {item.status}
                    </span>
                    {item.quality_score !== undefined && item.quality_score > 0 && (
                      <span class="text-[10px] font-mono text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded">
                        QS: {item.quality_score}
                      </span>
                    )}
                  </div>
                  <h3 class="text-sm font-semibold text-slate-900 truncate">
                    <a href={`/admin/content/${item.id}`} class="hover:text-blue-600">
                      {item.title}
                    </a>
                  </h3>
                  <div class="flex items-center space-x-3 text-[11px] text-slate-400 mt-1">
                    {item.organization_name && <span>{item.organization_name}</span>}
                    <span>Updated: {formatDate(item.updated_at)}</span>
                  </div>
                </div>

                <div class="flex items-center space-x-2 flex-shrink-0">
                  <a
                    href={`/admin/content/${item.id}`}
                    class="px-2.5 py-1 text-xs font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-md transition-colors"
                  >
                    Edit
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>

    <!-- Active Sources & Quick Action Cards (1 Column) -->
    <div class="space-y-6">
      
      <!-- Source Status Overview -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
        <div class="p-5 border-b border-slate-200 flex items-center justify-between">
          <div>
            <h2 class="text-base font-bold text-slate-900">Configured Sources</h2>
            <p class="text-xs text-slate-500">{activeSourceCount} active official endpoints</p>
          </div>
          <a href="/admin/sources" class="text-xs font-semibold text-blue-600 hover:text-blue-700">
            Manage &rarr;
          </a>
        </div>

        {allSources.length === 0 ? (
          <div class="p-6 text-center text-xs text-slate-500">
            No sources registered yet.
            <div class="mt-3">
              <a href="/admin/sources/new" class="text-xs font-semibold text-blue-600 hover:underline">
                + Register First Source
              </a>
            </div>
          </div>
        ) : (
          <div class="divide-y divide-slate-100">
            {allSources.slice(0, 5).map((src) => (
              <div class="p-3.5 hover:bg-slate-50 flex items-center justify-between text-xs">
                <div class="min-w-0 flex-1">
                  <p class="font-semibold text-slate-900 truncate">{src.name}</p>
                  <p class="text-[10px] text-slate-400 truncate">{src.base_url}</p>
                </div>
                <div class="flex items-center space-x-2 ml-2">
                  <span class="text-[10px] bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded font-mono">
                    {src.source_type}
                  </span>
                  <span class={`w-2 h-2 rounded-full ${src.health_status === 'failed' ? 'bg-rose-500' : src.health_status === 'warning' ? 'bg-amber-500' : 'bg-emerald-500'}`}></span>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Quick Action Cards -->
      <div class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-xl p-5 text-white shadow-xs border border-slate-700">
        <h3 class="text-sm font-bold mb-1 text-white">DeepSeek AI Engine Active</h3>
        <p class="text-xs text-slate-300 mb-4 leading-relaxed">
          12-Step pipeline with prompt injection defense, fact-checking verifier, and deterministic scoring.
        </p>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <a
            href="/admin/content/review"
            class="p-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-center font-semibold transition-colors"
          >
            Review Queue ({pendingReviewCount})
          </a>
          <a
            href="/admin/settings/ai"
            class="p-2.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-center font-semibold transition-colors"
          >
            AI Settings
          </a>
        </div>
      </div>

    </div>

  </div>

  <script>
    const autoPublishBtn = document.getElementById('btn-auto-publish-all') as HTMLButtonElement;
    autoPublishBtn?.addEventListener('click', async () => {
      if (!confirm('Auto-publish all pending and discovered recruitment notices now?')) return;
      autoPublishBtn.disabled = true;
      autoPublishBtn.innerHTML = '<span>⏳ Processing & Publishing...</span>';

      try {
        const res = await fetch('/api/admin/content/publish-all', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json() as any;
        if (res.ok && data.success) {
          alert(data.message || 'Auto-publishing complete!');
          window.location.reload();
        } else {
          alert('Error: ' + (data.error || 'Failed to auto-publish.'));
        }
      } catch (err: any) {
        alert('Network error: ' + err.message);
      } finally {
        autoPublishBtn.disabled = false;
        autoPublishBtn.innerHTML = '<span>⚡ Auto-Publish All Posts</span>';
      }
    });
  </script>
</AdminLayout>
