---
// src/pages/reset-password.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const token = Astro.url.searchParams.get('token') || '';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Reset Password' },
];
---

<BaseLayout
  title="Set New Password — RealSarkariExam"
  description="Enter your new password to restore access to your RealSarkariExam account."
  noindex={true}
>
  <div class="max-w-md mx-auto px-4 py-12">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mt-6 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
      <div class="text-center mb-6">
        <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">Set New Password</h1>
        <p class="text-xs text-slate-500 mt-1">Choose a secure password with at least 8 characters</p>
      </div>

      <div id="rp-msg" class="hidden mb-4 p-3 rounded-lg text-xs font-semibold"></div>

      <form id="reset-password-form" class="space-y-4 text-xs">
        <input type="hidden" name="token" value={token} />

        <div>
          <label class="block font-bold text-slate-700 mb-1">New Password</label>
          <input
            type="password"
            name="password"
            placeholder="At least 8 characters"
            minlength="8"
            required
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 focus:border-gov-navy focus:bg-white focus:outline-none transition-colors"
          />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Confirm New Password</label>
          <input
            type="password"
            name="confirmPassword"
            placeholder="Repeat new password"
            minlength="8"
            required
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 focus:border-gov-navy focus:bg-white focus:outline-none transition-colors"
          />
        </div>

        <button
          type="submit"
          id="rp-btn"
          class="w-full bg-gov-navy hover:bg-slate-900 text-white font-bold py-3 rounded-xl transition-all shadow-xs text-sm"
        >
          Update Password
        </button>
      </form>

      <div class="mt-6 pt-6 border-t border-slate-100 text-center text-xs text-slate-600">
        <a href="/login" class="text-blue-600 hover:underline font-bold">Back to Sign In</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('reset-password-form') as HTMLFormElement | null;
  const msgEl = document.getElementById('rp-msg');
  const btn = document.getElementById('rp-btn') as HTMLButtonElement | null;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Updating...';
      }

      const formData = new FormData(form);
      const payload = {
        token: formData.get('token'),
        password: formData.get('password'),
        confirmPassword: formData.get('confirmPassword'),
      };

      try {
        const res = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = (await res.json()) as any;

        if (data.success) {
          if (msgEl) {
            msgEl.textContent = data.message || 'Password has been reset! Redirecting to login...';
            msgEl.className = 'mb-4 p-3 rounded-lg text-xs font-semibold bg-emerald-50 border border-emerald-200 text-emerald-800';
            msgEl.classList.remove('hidden');
          }
          setTimeout(() => {
            window.location.href = '/login';
          }, 2000);
        } else {
          if (msgEl) {
            msgEl.textContent = data.error || 'Password reset failed.';
            msgEl.className = 'mb-4 p-3 rounded-lg text-xs font-semibold bg-rose-50 border border-rose-200 text-rose-700';
            msgEl.classList.remove('hidden');
          }
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Update Password';
          }
        }
      } catch (err: any) {
        if (msgEl) {
          msgEl.textContent = err.message || 'Network error.';
          msgEl.className = 'mb-4 p-3 rounded-lg text-xs font-semibold bg-rose-50 border border-rose-200 text-rose-700';
          msgEl.classList.remove('hidden');
        }
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Update Password';
        }
      }
    });
  }
</script>
