---
// src/pages/admin/seo/redirects.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db.ts';
import type { RedirectRecord } from '../../../lib/seo/types.ts';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

const redirects = (await db.query<RedirectRecord>('SELECT * FROM redirects ORDER BY created_at DESC')).results;
---

<AdminLayout title="Manage 301/302 Redirects">
  <div class="space-y-6">
    
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">URL Redirects Manager</h1>
        <p class="text-xs text-slate-500 mt-1">Configure 301/302 redirects to prevent 404 broken links and preserve search rankings.</p>
      </div>

      <a href="/admin/seo" class="text-xs font-bold text-slate-600 hover:text-slate-900">
        &larr; Back to SEO Dashboard
      </a>
    </div>

    <!-- Create Redirect Card -->
    <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-xs">
      <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-3">Add New Redirect Rule</h2>
      
      <form id="create-redirect-form" class="grid grid-cols-1 sm:grid-cols-12 gap-3 text-xs">
        <div class="sm:col-span-5">
          <label class="block font-bold text-slate-700 mb-1">Source Path (Old URL)</label>
          <input
            type="text"
            name="sourcePath"
            placeholder="/old-job-slug-2025"
            required
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 focus:border-gov-navy focus:outline-none"
          />
        </div>

        <div class="sm:col-span-5">
          <label class="block font-bold text-slate-700 mb-1">Destination Path (Target URL)</label>
          <input
            type="text"
            name="destinationPath"
            placeholder="/jobs/new-job-slug-2026"
            required
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 focus:border-gov-navy focus:outline-none"
          />
        </div>

        <div class="sm:col-span-2 flex items-end">
          <button
            type="submit"
            class="w-full bg-gov-navy hover:bg-slate-900 text-white font-bold py-2.5 rounded-lg transition-colors shadow-xs"
          >
            Create Rule
          </button>
        </div>
      </form>
      <div id="redirect-msg" class="mt-2 text-xs font-semibold hidden"></div>
    </div>

    <!-- Existing Redirects Table -->
    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-xs">
      <div class="bg-slate-50 px-4 py-3 border-b border-slate-200 flex items-center justify-between">
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Active Redirect Rules ({redirects.length})</h3>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-slate-100/70 border-b border-slate-200 text-slate-600 font-bold">
              <th class="py-2.5 px-4">Source Path</th>
              <th class="py-2.5 px-4">Destination Path</th>
              <th class="py-2.5 px-4">Status</th>
              <th class="py-2.5 px-4">Hits</th>
              <th class="py-2.5 px-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {redirects.map((r) => (
              <tr class="hover:bg-slate-50">
                <td class="py-2.5 px-4 font-mono font-bold text-slate-900">{r.source_path}</td>
                <td class="py-2.5 px-4 font-mono text-blue-600">{r.destination_path}</td>
                <td class="py-2.5 px-4">
                  <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 text-[10px] font-bold px-2 py-0.5 rounded">
                    {r.status_code} Permanent
                  </span>
                </td>
                <td class="py-2.5 px-4 font-medium text-slate-600">{r.hit_count}</td>
                <td class="py-2.5 px-4 text-right">
                  <button
                    type="button"
                    data-id={r.id}
                    class="delete-btn text-rose-600 hover:text-rose-800 font-bold"
                  >
                    Delete
                  </button>
                </td>
              </tr>
            ))}
            {redirects.length === 0 && (
              <tr>
                <td colspan="5" class="py-6 text-center text-slate-400">
                  No custom redirect rules active.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>

<script>
  const form = document.getElementById('create-redirect-form') as HTMLFormElement | null;
  const msg = document.getElementById('redirect-msg');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const payload = {
        sourcePath: formData.get('sourcePath'),
        destinationPath: formData.get('destinationPath'),
        statusCode: 301,
      };

      try {
        const res = await fetch('/api/admin/seo/redirects', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = (await res.json()) as any;
        if (data.success) {
          window.location.reload();
        } else {
          if (msg) {
            msg.textContent = data.error || 'Failed to create redirect';
            msg.className = 'mt-2 text-xs font-semibold text-rose-600';
            msg.classList.remove('hidden');
          }
        }
      } catch (err: any) {
        if (msg) {
          msg.textContent = err.message;
          msg.className = 'mt-2 text-xs font-semibold text-rose-600';
          msg.classList.remove('hidden');
        }
      }
    });
  }

  document.querySelectorAll('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      if (!id || !confirm('Are you sure you want to delete this redirect?')) return;

      try {
        const res = await fetch('/api/admin/seo/redirects', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        const data = (await res.json()) as any;
        if (data.success) window.location.reload();
      } catch {}
    });
  });
</script>
