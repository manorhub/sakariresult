---
// src/pages/register.astro
// Free User Registration Page

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Register' },
];
---

<BaseLayout
  title="Create Free Candidate Account — Sarkari Info"
  description="Register for a free Sarkari Info account to save jobs, follow UPSC/SSC/Railway boards, and receive personalized notifications."
  noindex={true}
>
  <div class="max-w-md mx-auto px-4 py-12">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mt-6 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
      <div class="text-center mb-6">
        <div class="w-12 h-12 rounded-xl bg-gov-navy text-white flex items-center justify-center font-black text-xl mx-auto mb-3 shadow-xs">
          SI
        </div>
        <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">Create Free Account</h1>
        <p class="text-xs text-slate-500 mt-1">Get verified job alerts and track application deadlines</p>
      </div>

      <div id="reg-error" class="hidden mb-4 p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold rounded-lg"></div>
      <div id="reg-success" class="hidden mb-4 p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold rounded-lg"></div>

      <form id="user-register-form" class="space-y-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Full Name</label>
          <input
            type="text"
            name="name"
            placeholder="e.g. Rahul Sharma"
            required
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 focus:border-gov-navy focus:bg-white focus:outline-none transition-colors"
          />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Email Address</label>
          <input
            type="email"
            name="email"
            placeholder="candidate@example.com"
            required
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 focus:border-gov-navy focus:bg-white focus:outline-none transition-colors"
          />
          <span class="text-[11px] text-slate-400">We send only verified notifications. No spam.</span>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Password</label>
          <input
            type="password"
            name="password"
            placeholder="At least 8 characters"
            minlength="8"
            required
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 focus:border-gov-navy focus:bg-white focus:outline-none transition-colors"
          />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Confirm Password</label>
          <input
            type="password"
            name="confirmPassword"
            placeholder="Repeat password"
            minlength="8"
            required
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 focus:border-gov-navy focus:bg-white focus:outline-none transition-colors"
          />
        </div>

        <div class="pt-2">
          <p class="text-[11px] text-slate-500 leading-relaxed">
            By creating an account, you agree to our{' '}
            <a href="/terms" class="text-blue-600 hover:underline">Terms of Use</a> and{' '}
            <a href="/privacy-policy" class="text-blue-600 hover:underline">Privacy Policy</a>.
          </p>
        </div>

        <button
          type="submit"
          id="reg-btn"
          class="w-full bg-gov-navy hover:bg-slate-900 text-white font-bold py-3 rounded-xl transition-all shadow-xs text-sm"
        >
          Create Account
        </button>
      </form>

      <div class="mt-6 pt-6 border-t border-slate-100 text-center text-xs text-slate-600">
        Already have an account?{' '}
        <a href="/login" class="text-blue-600 hover:underline font-bold">Sign In</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('user-register-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('reg-error');
  const successEl = document.getElementById('reg-success');
  const btn = document.getElementById('reg-btn') as HTMLButtonElement | null;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorEl) errorEl.classList.add('hidden');
      if (successEl) successEl.classList.add('hidden');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Creating account...';
      }

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        password: formData.get('password'),
        confirmPassword: formData.get('confirmPassword'),
      };

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = (await res.json()) as any;

        if (data.success) {
          form.reset();
          if (successEl) {
            successEl.textContent = data.message || 'Account created! Please check your email to verify.';
            successEl.classList.remove('hidden');
          }
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Account Created';
          }
          setTimeout(() => {
            window.location.href = '/login';
          }, 2500);
        } else {
          if (errorEl) {
            errorEl.textContent = data.error || 'Registration failed.';
            errorEl.classList.remove('hidden');
          }
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Create Account';
          }
        }
      } catch (err: any) {
        if (errorEl) {
          errorEl.textContent = err.message || 'Network error occurred.';
          errorEl.classList.remove('hidden');
        }
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Create Account';
        }
      }
    });
  }
</script>
