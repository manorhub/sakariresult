---
// src/components/SourceBox.astro
interface Props {
  sourceName?: string | null;
  sourceBaseUrl?: string | null;
  officialNotificationUrl?: string | null;
  publishedAt?: string | null;
  updatedAt?: string | null;
}

const {
  sourceName,
  sourceBaseUrl,
  officialNotificationUrl,
  publishedAt,
  updatedAt,
} = Astro.props;

const formattedPublishDate = publishedAt
  ? new Intl.DateTimeFormat('en-IN', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Asia/Kolkata',
    }).format(new Date(publishedAt))
  : null;

const formattedUpdateDate = updatedAt && updatedAt !== publishedAt
  ? new Intl.DateTimeFormat('en-IN', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Asia/Kolkata',
    }).format(new Date(updatedAt))
  : null;
---

<div class="bg-slate-50 rounded-xl border border-slate-200 p-4 sm:p-5 my-8 text-xs text-slate-700 space-y-3">
  <div class="flex items-center justify-between border-b border-slate-200 pb-2.5">
    <div class="flex items-center space-x-2">
      <svg class="w-4 h-4 text-gov-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <h3 class="font-bold text-slate-900 uppercase tracking-wider text-[11px]">
        Official Source Information
      </h3>
    </div>
    <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded">
      Verified Source
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <div>
      <span class="text-slate-500 block text-[11px]">Originating Authority:</span>
      <span class="font-semibold text-slate-800">{sourceName || 'Official Government Department'}</span>
    </div>

    {sourceBaseUrl && (
      <div>
        <span class="text-slate-500 block text-[11px]">Official Portal:</span>
        <a
          href={sourceBaseUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-blue-600 hover:underline break-all"
        >
          {sourceBaseUrl} &rarr;
        </a>
      </div>
    )}

    {formattedPublishDate && (
      <div>
        <span class="text-slate-500 block text-[11px]">First Published:</span>
        <span class="font-medium text-slate-800">{formattedPublishDate} (IST)</span>
      </div>
    )}

    {formattedUpdateDate && (
      <div>
        <span class="text-slate-500 block text-[11px]">Last Updated / Corrigendum:</span>
        <span class="font-medium text-amber-700">{formattedUpdateDate} (IST)</span>
      </div>
    )}
  </div>

  {officialNotificationUrl && (
    <div class="pt-2 border-t border-slate-200">
      <a
        href={officialNotificationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center text-xs font-semibold text-gov-navy hover:text-blue-700 underline"
      >
        <span>View Original Official Notification Document (PDF/Gazette)</span>
        <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  )}

  <p class="text-[11px] text-slate-500 italic pt-1">
    <strong>Disclaimer:</strong> Sarkari Info operates as an independent recruitment information index. Candidates must cross-check with original gazette notifications before making fee payments or submissions.
  </p>
</div>
