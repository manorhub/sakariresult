---
// src/components/admin/Sidebar.astro

export interface Props {
  currentPath?: string;
  adminName?: string;
  adminRole?: string;
}

const {
  currentPath = Astro.url.pathname,
  adminName = 'Administrator',
  adminRole = 'superadmin'
} = Astro.props;

const menuItems = [
  { name: 'Dashboard', href: '/admin/dashboard', icon: 'dashboard' },
  { name: 'AI Review Queue', href: '/admin/content/review', icon: 'sparkles', badge: 'AI' },
  { name: 'Content CMS', href: '/admin/content', icon: 'newspaper' },
  { name: 'Duplicate Engine', href: '/admin/content/duplicates', icon: 'files', badge: 'DEDUP' },
  { name: 'Sources & Crawlers', href: '/admin/sources', icon: 'database' },
  { name: 'Crawl Logs', href: '/admin/logs/crawls', icon: 'activity' },
  { name: 'Categories', href: '/admin/categories', icon: 'tags' },
  { name: 'Organizations', href: '/admin/organizations', icon: 'building' },
  { name: 'Documents (R2)', href: '/admin/documents', icon: 'files' },
  { name: 'AI Settings', href: '/admin/settings/ai', icon: 'cpu' },
  { name: 'AI Prompts', href: '/admin/settings/prompts', icon: 'code' },
  { name: 'Candidates', href: '/admin/users', icon: 'users' },
  { name: 'Notifications', href: '/admin/notifications', icon: 'bell' },
  { name: 'Revenue', href: '/admin/revenue', icon: 'credit-card' },
  { name: 'Search Analytics', href: '/admin/analytics/searches', icon: 'search' },
  { name: 'System Health', href: '/admin/system-health', icon: 'activity' },
  { name: 'Error Logs', href: '/admin/logs/errors', icon: 'alert-triangle' },
  { name: 'Audit Logs', href: '/admin/logs/audit', icon: 'file-text' },
  { name: 'SEO Engine', href: '/admin/seo', icon: 'search' },
  { name: 'Google Indexing', href: '/admin/seo/indexing', icon: 'zap', badge: 'API' },
  { name: 'Ad Settings', href: '/admin/settings/ads', icon: 'layout' },
  { name: 'Feature Flags', href: '/admin/settings/flags', icon: 'toggle-right' },
  { name: 'System Settings', href: '/admin/settings', icon: 'settings' },
];
---

<aside class="w-64 bg-slate-900 text-slate-300 flex flex-col flex-shrink-0 h-full border-r border-slate-800">
  <!-- Brand Area -->
  <div class="h-16 flex items-center px-6 border-b border-slate-800 justify-between">
    <a href="/admin/dashboard" class="flex items-center space-x-2.5">
      <div class="w-8 h-8 rounded bg-gradient-to-tr from-gov-saffron to-amber-500 flex items-center justify-center text-white font-black text-xs tracking-tighter">RSE</div>
      <div>
        <span class="text-base font-bold text-white tracking-tight">REAL<span class="text-gov-saffron">SARKARI</span></span>
        <span class="block text-[10px] text-slate-400 font-mono">v1.0 • Phase 3 AI Engine</span>
      </div>
    </a>
  </div>

  <!-- User Card -->
  <div class="px-5 py-4 border-b border-slate-800 bg-slate-950/40">
    <div class="flex items-center space-x-3">
      <div class="w-9 h-9 rounded-full bg-blue-600/30 text-blue-400 border border-blue-500/40 flex items-center justify-center font-bold text-sm">
        {adminName.charAt(0).toUpperCase()}
      </div>
      <div class="overflow-hidden">
        <p class="text-xs font-semibold text-white truncate">{adminName}</p>
        <span class="inline-block text-[10px] uppercase font-bold text-amber-400 tracking-wider">
          {adminRole}
        </span>
      </div>
    </div>
  </div>

  <!-- Menu Navigation -->
  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    {menuItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/admin/dashboard' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`flex items-center justify-between px-3 py-2.5 rounded-lg text-xs font-semibold transition-all ${
            isActive
              ? 'bg-blue-600 text-white shadow-sm'
              : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60'
          }`}
        >
          <div class="flex items-center space-x-3">
            {item.icon === 'dashboard' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
            )}
            {item.icon === 'sparkles' && (
              <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            )}
            {item.icon === 'database' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
              </svg>
            )}
            {item.icon === 'tags' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
            )}
            {item.icon === 'building' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            )}
            {item.icon === 'newspaper' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
            )}
            {item.icon === 'files' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            )}
            {item.icon === 'cpu' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
            )}
            {item.icon === 'code' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            )}
            {item.icon === 'search' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            )}
            {item.icon === 'settings' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            )}
            {item.icon === 'activity' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
            {item.icon === 'zap' && (
              <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
            <span>{item.name}</span>
          </div>
          {item.badge && (
            <span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold uppercase bg-amber-400/20 text-amber-300 border border-amber-400/30">
              {item.badge}
            </span>
          )}
        </a>
      );
    })}
  </nav>

  <!-- Bottom Quick Links & Logout -->
  <div class="p-4 border-t border-slate-800 space-y-2">
    <a
      href="/"
      target="_blank"
      class="flex items-center space-x-2 px-3 py-2 rounded-md text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
      <span>View Live Website</span>
    </a>
    <a
      href="/admin/logout"
      class="flex items-center space-x-2 px-3 py-2 rounded-md text-xs font-semibold text-rose-400 hover:text-rose-300 hover:bg-rose-950/40 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      <span>Logout</span>
    </a>
  </div>
</aside>
