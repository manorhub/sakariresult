---
// src/components/ads/AdSlotSidebar.astro
// Sidebar Banner Ad Placement

import { getDb } from '../../lib/db.ts';
import { evaluateAdDisplay } from '../../lib/monetization/ads.ts';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const isDev = import.meta.env.DEV;
let adState = { showAd: false, isDev: false, provider: 'none', publisherId: '', slotType: 'sidebar' };

if (d1) {
  const db = getDb(d1);
  adState = await evaluateAdDisplay(db, 'sidebar', isDev);
} else if (isDev) {
  adState = { showAd: true, isDev: true, provider: 'mock', publisherId: 'dev-mode', slotType: 'sidebar' };
}
---

{adState.showAd && (
  <div class="my-4 p-3 bg-white rounded-2xl border border-slate-200 shadow-xs text-center" aria-label="Sidebar Advertisement">
    <span class="text-[9px] font-extrabold uppercase tracking-widest text-slate-400 block mb-1">
      ADVERTISEMENT
    </span>
    {adState.isDev ? (
      <div class="w-full h-64 bg-slate-100 border border-dashed border-slate-300 rounded-xl flex items-center justify-center text-xs font-semibold text-slate-500 p-4">
        Sidebar Ad (300x250 / 300x600)
      </div>
    ) : (
      <div class="ad-slot-container min-h-[250px] w-full" data-ad-slot="sidebar" data-publisher={adState.publisherId}>
        <!-- Provider Script Integration Container -->
      </div>
    )}
  </div>
)}
