---
// src/components/SEO.astro
import { buildCanonicalUrl } from '../lib/seo/canonical.ts';
import type { RobotsDirective } from '../lib/seo/types.ts';

export interface Props {
  title?: string | null;
  description?: string | null;
  canonicalUrl?: string | null;
  ogImage?: string | null;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  robots?: RobotsDirective | string;
  publishedTime?: string | null;
  modifiedTime?: string | null;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title = 'RealSarkariExam — Indian Govt Jobs, Results, Admit Cards & Exam Alerts',
  description = 'Find the latest Indian Government Jobs (Sarkari Naukri), Exam Results, Admit Cards, Answer Keys, Syllabus, and Schemes with verified official notifications.',
  canonicalUrl,
  ogImage = '/og-default.png',
  ogType = 'website',
  noindex = false,
  robots,
  publishedTime,
  modifiedTime,
  jsonLd
} = Astro.props;

const siteUrl = Astro.site?.toString() || Astro.url.origin;
const canonical = buildCanonicalUrl(canonicalUrl || Astro.url.pathname, { siteUrl });
const imageTarget = ogImage || '/og-default.png';
const fullOgImage = imageTarget.startsWith('http') ? imageTarget : new URL(imageTarget, siteUrl).toString();

const siteName = 'RealSarkariExam';
const formattedTitle = title ? (title.includes(siteName) ? title : `${title} | ${siteName}`) : siteName;

let robotsContent = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
if (noindex) {
  robotsContent = 'noindex, follow';
} else if (robots) {
  robotsContent = robots;
}
---

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
{description && <meta name="description" content={description} />}
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="canonical" href={canonical} />

<!-- Robots -->
<meta name="robots" content={robotsContent} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={formattedTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={fullOgImage} />
<meta property="og:locale" content="en_IN" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={formattedTitle} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={fullOgImage} />

<!-- Favicons & Mobile theme -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#0c2340" />

<!-- Structured Data (JSON-LD) -->
{jsonLd && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
