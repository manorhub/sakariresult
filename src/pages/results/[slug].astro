---
// src/pages/results/[slug].astro
// Single Result Page with Merit List Links, Cut-Off Marks, and Related Exam Cards

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ImportantLinks from '../../components/ImportantLinks.astro';
import SourceBox from '../../components/SourceBox.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import AdminPreviewBanner from '../../components/AdminPreviewBanner.astro';
import { getDb } from '../../lib/db.ts';
import { getContentItemBySlug, getRelatedContent } from '../../lib/public_queries.ts';
import { renderMarkdownToHtml } from '../../lib/markdown.ts';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/results');

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

const isPreviewQuery = Astro.url.searchParams.get('preview') === 'true';
const { item, isPreview } = await getContentItemBySlug(db, 'result', slug, { allowPreview: isPreviewQuery });

if (!item) {
  return Astro.redirect('/404');
}

let extractedData: any = {};
let faqs: any[] = [];
try { if (item.extracted_data_json) extractedData = JSON.parse(item.extracted_data_json); } catch {}
try { if (item.faq_json) faqs = JSON.parse(item.faq_json); } catch {}

const relatedItems = await getRelatedContent(db, item, 6);

const actionLinks = [
  { label: 'Download Result / Merit List (PDF)', url: item.result_url || extractedData.result_url || extractedData.merit_list_url, isPrimary: true, type: 'result' as const },
  { label: 'Check Cut-Off Marks Notice', url: extractedData.cutoff_url, type: 'result' as const },
  { label: 'Official Examination Portal', url: item.organization_website || extractedData.official_website_url, type: 'official_site' as const },
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Results', href: '/results' },
  { label: item.title },
];
---

<BaseLayout
  title={item.seo_title || `${item.title} — Check Result & Merit List`}
  description={item.meta_description || item.excerpt || `Download ${item.title} scorecard, merit list PDF, and cut-off marks.`}
  canonicalUrl={item.canonical_url || `${Astro.site ? Astro.site.toString() : 'https://sarkariinfo.in'}/results/${item.slug}`}
>
  {isPreview && <AdminPreviewBanner status={item.status} itemId={item.id} />}

  <div class="max-w-5xl mx-auto px-4 py-6">
    <Breadcrumbs items={breadcrumbs} />

    <article class="mt-4 bg-white rounded-2xl border border-slate-200 p-5 sm:p-8 shadow-xs">
      
      <header class="border-b border-slate-200 pb-6 mb-6">
        <div class="flex items-center space-x-2 mb-2 flex-wrap gap-y-1">
          <span class="bg-emerald-600 text-white text-[11px] font-bold px-2.5 py-0.5 rounded">
            Exam Result
          </span>
          {item.organization_name && (
            <span class="bg-slate-100 text-slate-700 text-[11px] font-semibold px-2.5 py-0.5 rounded border border-slate-200">
              {item.organization_name}
            </span>
          )}
          <span class="bg-emerald-100 text-emerald-900 text-[11px] font-bold px-2.5 py-0.5 rounded">
            Declared / Released
          </span>
        </div>

        <h1 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight">
          {item.title}
        </h1>

        {item.update_summary && (
          <div class="mt-3 p-3 bg-amber-50 rounded-xl border border-amber-200 text-xs text-amber-950 flex items-start space-x-2">
            <span class="bg-amber-600 text-white font-black text-[10px] px-1.5 py-0.5 rounded shrink-0">NOTICE</span>
            <p class="font-medium">{item.update_summary}</p>
          </div>
        )}
      </header>

      <!-- Key Result Facts Table -->
      <div class="bg-slate-50 rounded-xl border border-slate-200 p-4 mb-6 text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <span class="text-slate-500 block text-[11px]">Examination Board:</span>
            <strong class="text-slate-900">{item.organization_name || 'Official Board'}</strong>
          </div>
          <div>
            <span class="text-slate-500 block text-[11px]">Result Declaration Date:</span>
            <strong class="text-emerald-700">{extractedData.result_date || item.published_at || 'Recently Announced'}</strong>
          </div>
          <div>
            <span class="text-slate-500 block text-[11px]">Status:</span>
            <strong class="text-emerald-800">Result Available Online</strong>
          </div>
        </div>
      </div>

      <!-- Important Action Links -->
      <ImportantLinks links={actionLinks} title="Direct Result & Scorecard Access" />

      <!-- Article Markdown Body -->
      {item.article_content ? (
        <div class="prose prose-sm sm:prose max-w-none text-slate-800 leading-relaxed font-sans mt-8 divide-y-0 space-y-6">
          <div class="article-markdown-body" set:html={renderMarkdownToHtml(item.article_content)} />
        </div>
      ) : (
        <div class="text-xs sm:text-sm text-slate-700 space-y-3 mt-6">
          <h2 class="text-base font-bold text-slate-900">How to Check {item.title}:</h2>
          <ol class="list-decimal pl-5 space-y-1.5 leading-relaxed">
            <li>Visit the official result link provided in the table above.</li>
            <li>Enter your Roll Number, Registration Number, or Date of Birth.</li>
            <li>Click Submit to view your scorecard and qualifying status.</li>
            <li>Download and save the merit list PDF for future reference.</li>
          </ol>
        </div>
      )}

      <!-- FAQs -->
      {faqs.length > 0 && (
        <FAQAccordion faqs={faqs} title={`Frequently Asked Questions: ${item.title}`} />
      )}

      <SourceBox
        sourceName={item.source_name || item.organization_name}
        sourceBaseUrl={item.source_base_url || item.organization_website}
        officialNotificationUrl={item.official_notification_url || extractedData.official_notification_url}
        publishedAt={item.published_at}
        updatedAt={item.updated_at}
      />

    </article>

    {relatedItems.length > 0 && (
      <RelatedContent items={relatedItems} title="Related Examination Results & Updates" />
    )}

  </div>
</BaseLayout>
