---
// src/pages/admin/organizations/new.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Add New Organization" subtitle="Register a recruitment board or government department." activeNav="/admin/organizations">
  
  <div class="max-w-2xl bg-white rounded-xl border border-slate-200 p-6 sm:p-8 shadow-sm">
    <div id="form-alert" class="hidden mb-6 p-4 rounded-lg bg-rose-50 border border-rose-200 text-xs text-rose-700"></div>

    <form id="org-form" class="space-y-5">
      <div>
        <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Organization / Board Name *
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="e.g. Staff Selection Commission (SSC)"
          class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
        />
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="slug" class="block text-xs font-bold uppercase tracking-wider text-slate-700">
            URL Slug (Optional - auto generated)
          </label>
          <span class="text-[11px] text-slate-400 font-mono">e.g. ssc</span>
        </div>
        <input
          type="text"
          id="slug"
          name="slug"
          placeholder="ssc"
          class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm font-mono focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
        />
      </div>

      <div>
        <label for="website" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Official Website URL
        </label>
        <input
          type="url"
          id="website"
          name="website"
          placeholder="https://ssc.gov.in"
          class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
        />
      </div>

      <div>
        <label for="logo_r2_key" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Logo R2 Key / URL (Optional)
        </label>
        <input
          type="text"
          id="logo_r2_key"
          name="logo_r2_key"
          placeholder="logos/ssc-logo.png"
          class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm font-mono focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
        />
      </div>

      <div>
        <label for="description" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Description
        </label>
        <textarea
          id="description"
          name="description"
          rows="3"
          placeholder="Central recruitment agency under Ministry of Personnel..."
          class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
        ></textarea>
      </div>

      <div>
        <label for="status" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Status
        </label>
        <select
          id="status"
          name="status"
          class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm bg-white focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
        >
          <option value="active" selected>Active</option>
          <option value="inactive">Inactive</option>
        </select>
      </div>

      <div class="pt-4 border-t border-slate-200 flex items-center justify-end space-x-3">
        <a
          href="/admin/organizations"
          class="px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
        >
          Cancel
        </a>
        <button
          type="submit"
          id="btn-save"
          class="px-5 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-xs transition-colors cursor-pointer"
        >
          Save Organization
        </button>
      </div>
    </form>
  </div>

</AdminLayout>

<script>
  const form = document.getElementById('org-form') as HTMLFormElement;
  const alertBox = document.getElementById('form-alert');
  const btnSave = document.getElementById('btn-save') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (alertBox) alertBox.classList.add('hidden');
    if (btnSave) btnSave.disabled = true;

    const formData = new FormData(form);
    const payload = {
      name: formData.get('name'),
      slug: formData.get('slug'),
      website: formData.get('website'),
      logo_r2_key: formData.get('logo_r2_key'),
      description: formData.get('description'),
      status: formData.get('status'),
    };

    try {
      const res = await fetch('/api/admin/organizations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = (await res.json()) as any;
      if (res.ok && data.success) {
        window.location.href = '/admin/organizations';
      } else {
        if (alertBox) {
          alertBox.textContent = data.error || 'Failed to save organization.';
          alertBox.classList.remove('hidden');
        }
      }
    } catch (err: any) {
      if (alertBox) {
        alertBox.textContent = 'Server communication error.';
        alertBox.classList.remove('hidden');
      }
    } finally {
      if (btnSave) btnSave.disabled = false;
    }
  });
</script>
