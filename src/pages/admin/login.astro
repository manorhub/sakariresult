---
// src/pages/admin/login.astro
import '../../styles/global.css';

export const prerender = false;
---

<!doctype html>
<html lang="en" class="h-full bg-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login — RealSarkariExam Control Panel</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-full flex items-center justify-center p-4 bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-slate-100 font-sans">
    
    <div class="w-full max-w-md">
      
      <!-- Brand Logo Header -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-gov-saffron to-amber-500 text-white font-black text-xl shadow-lg mb-3 tracking-tighter">
          RSE
        </div>
        <h1 class="text-2xl font-black tracking-tight text-white">
          REAL<span class="text-gov-saffron">SARKARI</span><span class="text-amber-400">EXAM</span>
        </h1>
        <p class="text-xs text-slate-400 mt-1">
          Government Jobs & Results CMS Management Panel
        </p>
      </div>

      <!-- Login Card -->
      <div class="bg-slate-800/80 backdrop-blur border border-slate-700/80 rounded-2xl p-6 sm:p-8 shadow-2xl">
        
        <div id="alert-error" class="hidden mb-5 p-3.5 rounded-lg bg-rose-950/60 border border-rose-600/50 text-xs text-rose-300 flex items-start space-x-2">
          <svg class="w-4 h-4 text-rose-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span id="alert-error-text">Invalid login credentials.</span>
        </div>

        <form id="login-form" class="space-y-4">
          
          <div>
            <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
              Admin Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full px-3.5 py-2.5 rounded-lg bg-slate-900/90 border border-slate-700 text-white text-sm focus:border-amber-400 focus:ring-1 focus:ring-amber-400 placeholder-slate-500"
              placeholder="Enter your admin email"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">
                Password
              </label>
            </div>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="w-full px-3.5 py-2.5 rounded-lg bg-slate-900/90 border border-slate-700 text-white text-sm focus:border-amber-400 focus:ring-1 focus:ring-amber-400 placeholder-slate-500"
              placeholder="Enter your password"
            />
          </div>

          <div class="pt-2">
            <button
              id="submit-btn"
              type="submit"
              class="w-full py-2.5 px-4 rounded-lg bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-semibold text-sm shadow-md hover:shadow-lg transition-all focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-900 flex items-center justify-center space-x-2 cursor-pointer"
            >
              <span id="btn-text">Sign In to Dashboard</span>
              <svg id="btn-spinner" class="w-4 h-4 text-white animate-spin hidden" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>

        </form>

      </div>

      <div class="mt-6 text-center text-xs text-slate-500">
        &larr; <a href="/" class="hover:text-amber-400 transition-colors">Return to RealSarkariExam Public Portal</a>
      </div>

    </div>

    <script>
      const form = document.getElementById('login-form') as HTMLFormElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const btnText = document.getElementById('btn-text') as HTMLSpanElement;
      const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;
      const alertError = document.getElementById('alert-error') as HTMLDivElement;
      const alertErrorText = document.getElementById('alert-error-text') as HTMLSpanElement;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Hide previous errors
        alertError.classList.add('hidden');
        
        // Button loading state
        submitBtn.disabled = true;
        btnText.textContent = 'Authenticating...';
        btnSpinner.classList.remove('hidden');

        const formData = new FormData(form);
        const email = formData.get('email');
        const password = formData.get('password');

        try {
          const response = await fetch('/api/admin/auth/login', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ email, password }),
          });

          const data = await response.json() as any;

          if (response.ok && data.success) {
            btnText.textContent = 'Redirecting...';
            // Redirect to dashboard
            window.location.href = data.redirect || '/admin/dashboard';
          } else {
            // Show error message
            alertErrorText.textContent = data.error || 'Authentication failed. Please check your credentials.';
            alertError.classList.remove('hidden');
            
            // Reset button state
            submitBtn.disabled = false;
            btnText.textContent = 'Sign In to Dashboard';
            btnSpinner.classList.add('hidden');
          }
        } catch (err: any) {
          alertErrorText.textContent = 'Network or server error occurred. Please try again.';
          alertError.classList.remove('hidden');
          
          submitBtn.disabled = false;
          btnText.textContent = 'Sign In to Dashboard';
          btnSpinner.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>
