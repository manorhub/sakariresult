---
// src/pages/schemes/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Pagination from '../../components/Pagination.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getDb } from '../../lib/db.ts';
import { getCategoryContent } from '../../lib/public_queries.ts';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

const url = new URL(Astro.request.url);
const page = parseInt(url.searchParams.get('page') || '1', 10);

const result = await getCategoryContent(db, 'scheme', {
  page,
  limit: 12,
});

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Government Schemes' },
];
---

<BaseLayout
  title="Government Welfare Schemes (Yojana) 2026 — Benefits, Eligibility & Application"
  description="Verified central and state government schemes (Sarkari Yojana), welfare benefits, youth training subsidies, and application procedures."
>
  <div class="max-w-7xl mx-auto px-4 py-6">
    <Breadcrumbs items={breadcrumbs} />

    <div class="my-6">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        Government Schemes (Sarkari Yojana) 2026
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-3xl">
        Official welfare initiatives, skill development programs, and direct benefit schemes from ministries.
      </p>
    </div>

    {result.items.length > 0 ? (
      <>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {result.items.map((item) => (
            <ContentCard item={item} />
          ))}
        </div>

        <Pagination
          currentPage={result.page}
          totalPages={result.totalPages}
          baseUrl="/schemes"
        />
      </>
    ) : (
      <EmptyState
        title="No Welfare Schemes Listed"
        message="Government welfare schemes and guidelines will appear here upon publication."
      />
    )}
  </div>
</BaseLayout>
