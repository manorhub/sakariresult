---
// src/pages/exams/[slug].astro
// Single Exam Page with Relationships from D1 (Related Jobs, Admit Cards, Results, Syllabus)

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ImportantLinks from '../../components/ImportantLinks.astro';
import SourceBox from '../../components/SourceBox.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import AdminPreviewBanner from '../../components/AdminPreviewBanner.astro';
import { getDb } from '../../lib/db.ts';
import { getContentItemBySlug, getRelatedContent } from '../../lib/public_queries.ts';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/exams');

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

const isPreviewQuery = Astro.url.searchParams.get('preview') === 'true';
const { item, isPreview } = await getContentItemBySlug(db, 'exam', slug, { allowPreview: isPreviewQuery });

if (!item) {
  return Astro.redirect('/404');
}

let extractedData: any = {};
let faqs: any[] = [];
try { if (item.extracted_data_json) extractedData = JSON.parse(item.extracted_data_json); } catch {}
try { if (item.faq_json) faqs = JSON.parse(item.faq_json); } catch {}

const relatedItems = await getRelatedContent(db, item, 6);

const actionLinks = [
  { label: 'Download Exam Schedule / Date Notice (PDF)', url: item.official_notification_url || extractedData.official_notification_url, isPrimary: true, type: 'notification' as const },
  { label: 'Download Admit Card / Call Letter', url: item.admit_card_url || extractedData.admit_card_url, type: 'admit_card' as const },
  { label: 'Check Exam Result & Merit List', url: item.result_url || extractedData.result_url, type: 'result' as const },
  { label: 'Official Authority Portal', url: item.organization_website || extractedData.official_website_url, type: 'official_site' as const },
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Exams', href: '/exams' },
  { label: item.title },
];
---

<BaseLayout
  title={item.seo_title || `${item.title} — Exam Date, Shifts & Schedule`}
  description={item.meta_description || item.excerpt || `Check ${item.title} examination date, shift timings, reporting instructions, and related notices.`}
  canonicalUrl={item.canonical_url || `${Astro.site ? Astro.site.toString() : 'https://sarkariinfo.in'}/exams/${item.slug}`}
>
  {isPreview && <AdminPreviewBanner status={item.status} itemId={item.id} />}

  <div class="max-w-5xl mx-auto px-4 py-6">
    <Breadcrumbs items={breadcrumbs} />

    <article class="mt-4 bg-white rounded-2xl border border-slate-200 p-5 sm:p-8 shadow-xs">
      
      <header class="border-b border-slate-200 pb-6 mb-6">
        <div class="flex items-center space-x-2 mb-2 flex-wrap gap-y-1">
          <span class="bg-indigo-600 text-white text-[11px] font-bold px-2.5 py-0.5 rounded">
            Exam Schedule
          </span>
          {item.organization_name && (
            <span class="bg-slate-100 text-slate-700 text-[11px] font-semibold px-2.5 py-0.5 rounded border border-slate-200">
              {item.organization_name}
            </span>
          )}
          <span class="bg-indigo-100 text-indigo-900 text-[11px] font-bold px-2.5 py-0.5 rounded">
            Exam Announced
          </span>
        </div>

        <h1 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight">
          {item.title}
        </h1>

        {item.update_summary && (
          <div class="mt-3 p-3 bg-amber-50 rounded-xl border border-amber-200 text-xs text-amber-950 flex items-start space-x-2">
            <span class="bg-amber-600 text-white font-black text-[10px] px-1.5 py-0.5 rounded shrink-0">NOTICE</span>
            <p class="font-medium">{item.update_summary}</p>
          </div>
        )}
      </header>

      <!-- Key Dates Grid -->
      <div class="bg-slate-50 rounded-xl border border-slate-200 p-4 mb-6 text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <span class="text-slate-500 block text-[11px]">Exam Conducting Body:</span>
            <strong class="text-slate-900">{item.organization_name || 'Official Board'}</strong>
          </div>
          <div>
            <span class="text-slate-500 block text-[11px]">Examination Date / Shift:</span>
            <strong class="text-indigo-800">{extractedData.exam_date || item.published_at || 'As Notified'}</strong>
          </div>
          <div>
            <span class="text-slate-500 block text-[11px]">Admit Card Status:</span>
            <strong class="text-slate-800">{item.admit_card_url ? 'Released' : 'To be Released'}</strong>
          </div>
        </div>
      </div>

      <ImportantLinks links={actionLinks} title="Exam Schedule & Direct Portals" />

      {item.article_content ? (
        <div class="prose prose-sm sm:prose max-w-none text-slate-800 leading-relaxed font-sans mt-8 divide-y-0 space-y-6">
          <div class="article-markdown-body" set:html={item.article_content.replace(/## /g, '<h2 class="text-lg sm:text-xl font-bold text-slate-900 border-b border-slate-200 pb-2 mt-8 mb-4">').replace(/### /g, '<h3 class="text-base font-bold text-slate-800 mt-6 mb-2">').replace(/\n\n/g, '<br/><br/>')} />
        </div>
      ) : (
        <div class="text-xs sm:text-sm text-slate-700 space-y-3 mt-6">
          <h2 class="text-base font-bold text-slate-900">Important Instructions for Candidates:</h2>
          <ul class="list-disc pl-5 space-y-1.5 leading-relaxed">
            <li>Candidates must bring a printed copy of the Admit Card along with original Photo Identity Proof.</li>
            <li>Check the examination center address and reporting time in advance to prevent last-minute rush.</li>
            <li>Strictly follow the banned item instructions mentioned in the official notice.</li>
          </ul>
        </div>
      )}

      {faqs.length > 0 && (
        <FAQAccordion faqs={faqs} title={`Frequently Asked Questions: ${item.title}`} />
      )}

      <SourceBox
        sourceName={item.source_name || item.organization_name}
        sourceBaseUrl={item.source_base_url || item.organization_website}
        officialNotificationUrl={item.official_notification_url || extractedData.official_notification_url}
        publishedAt={item.published_at}
        updatedAt={item.updated_at}
      />

    </article>

    {relatedItems.length > 0 && (
      <RelatedContent items={relatedItems} title="Related Recruitment & Examination Notices" />
    )}

  </div>
</BaseLayout>
