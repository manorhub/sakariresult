---
// src/pages/admit-card/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Pagination from '../../components/Pagination.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getDb } from '../../lib/db.ts';
import { getCategoryContent } from '../../lib/public_queries.ts';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

const url = new URL(Astro.request.url);
const page = parseInt(url.searchParams.get('page') || '1', 10);
const organizationSlug = url.searchParams.get('organization') || '';

const result = await getCategoryContent(db, 'admit_card', {
  page,
  limit: 12,
  organizationSlug,
});

const orgs = (await db.query<{ name: string; slug: string }>('SELECT name, slug FROM organizations ORDER BY name ASC')).results;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Admit Cards & Hall Tickets' },
];
---

<BaseLayout
  title="Sarkari Admit Cards 2026 — Download Exam Call Letters & Hall Tickets"
  description="Download official government examination admit cards, hall tickets, city intimation slips, and exam day instructions for UPSC, SSC, RRB, Banking, and Police exams."
>
  <div class="max-w-7xl mx-auto px-4 py-6">
    <Breadcrumbs items={breadcrumbs} />

    <div class="my-6">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        Sarkari Admit Cards & Hall Tickets 2026
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-3xl">
        Direct official download portals for government recruitment preliminary, main, and skill test call letters.
      </p>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white rounded-xl border border-slate-200 p-4 mb-8 shadow-xs flex flex-wrap gap-4 items-center justify-between">
      <form action="/admit-card" method="GET" class="flex items-center space-x-3 w-full sm:w-auto">
        <label class="text-xs font-bold text-slate-700 uppercase">Authority:</label>
        <select
          name="organization"
          class="text-xs bg-slate-50 border border-slate-300 rounded-lg p-2 focus:border-gov-navy focus:outline-none"
          onchange="this.form.submit()"
        >
          <option value="">All Authorities</option>
          {orgs.map((o) => (
            <option value={o.slug} selected={organizationSlug === o.slug}>
              {o.name}
            </option>
          ))}
        </select>
      </form>
      <span class="text-xs text-slate-500 font-medium">Showing {result.total} available admit cards</span>
    </div>

    {result.items.length > 0 ? (
      <>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {result.items.map((item) => (
            <ContentCard item={item} />
          ))}
        </div>

        <Pagination
          currentPage={result.page}
          totalPages={result.totalPages}
          baseUrl="/admit-card"
          searchParams={{ organization: organizationSlug }}
        />
      </>
    ) : (
      <EmptyState
        title="No Admit Cards Released Currently"
        message="Active hall tickets and examination call letters will appear here as soon as published."
        actionUrl="/admit-card"
        actionLabel="View All Admit Cards"
      />
    )}
  </div>
</BaseLayout>
