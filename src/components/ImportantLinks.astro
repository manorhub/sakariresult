---
// src/components/ImportantLinks.astro
interface LinkItem {
  label: string;
  url?: string | null;
  type?: 'apply' | 'notification' | 'admit_card' | 'result' | 'answer_key' | 'official_site' | 'other';
  isPrimary?: boolean;
}

interface Props {
  links: LinkItem[];
  title?: string;
}

const { links, title = 'Important Links & Direct Access' } = Astro.props;

// Filter out empty entries
const validLinks = links.filter(l => l.label && l.label.trim().length > 0);
---

{validLinks.length > 0 && (
  <div class="bg-white rounded-xl border-2 border-slate-200 shadow-sm overflow-hidden my-8">
    <div class="bg-gradient-to-r from-gov-navy to-slate-800 text-white px-5 py-3.5 flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <svg class="w-5 h-5 text-gov-saffron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
        <h2 class="text-sm sm:text-base font-bold tracking-tight">{title}</h2>
      </div>
      <span class="text-[11px] bg-slate-700/70 text-slate-300 px-2 py-0.5 rounded font-mono">
        Verified Official Links
      </span>
    </div>

    <div class="divide-y divide-slate-100">
      {validLinks.map((link) => {
        const hasUrl = Boolean(link.url && link.url.trim().length > 0);
        return (
          <div class="p-3.5 sm:p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 hover:bg-slate-50/80 transition-colors">
            <div class="flex items-center space-x-2">
              <span class="w-2 h-2 rounded-full bg-gov-saffron shrink-0"></span>
              <span class="text-xs sm:text-sm font-bold text-slate-800">
                {link.label}
              </span>
            </div>

            <div class="shrink-0">
              {hasUrl ? (
                <a
                  href={link.url!}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`inline-flex items-center justify-center px-4 py-2 text-xs font-bold rounded-lg transition-all shadow-xs ${
                    link.isPrimary
                      ? 'bg-gov-saffron hover:bg-orange-600 text-white'
                      : 'bg-slate-800 hover:bg-slate-900 text-white'
                  }`}
                >
                  <span>Click Here</span>
                  <svg class="w-3.5 h-3.5 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ) : (
                <span class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-slate-400 bg-slate-100 rounded-md cursor-not-allowed border border-slate-200">
                  <span>Link Not Released Yet</span>
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Security Footnote -->
    <div class="bg-slate-50 px-4 py-2.5 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
      <span class="flex items-center space-x-1">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>All links redirect to official authorized government domains.</span>
      </span>
    </div>
  </div>
)}
