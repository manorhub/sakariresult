---
// src/components/admin/StatCard.astro

export interface Props {
  title: string;
  value: number | string;
  change?: string;
  subtitle?: string;
  color?: 'blue' | 'emerald' | 'amber' | 'purple' | 'rose' | 'slate';
  icon?: string;
}

const {
  title,
  value,
  subtitle,
  color = 'blue'
} = Astro.props;

const colorStyles = {
  blue: 'bg-blue-50 border-blue-200 text-blue-700',
  emerald: 'bg-emerald-50 border-emerald-200 text-emerald-700',
  amber: 'bg-amber-50 border-amber-200 text-amber-700',
  purple: 'bg-purple-50 border-purple-200 text-purple-700',
  rose: 'bg-rose-50 border-rose-200 text-rose-700',
  slate: 'bg-slate-50 border-slate-200 text-slate-700',
}[color];
---

<div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:shadow transition-shadow">
  <div class="flex items-center justify-between">
    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">{title}</span>
    <span class={`p-1.5 rounded-lg border text-xs font-bold ${colorStyles}`}>
      <slot name="icon" />
    </span>
  </div>
  <div class="mt-3">
    <span class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">{value}</span>
  </div>
  {subtitle && (
    <p class="mt-1 text-xs text-slate-500">{subtitle}</p>
  )}
</div>
