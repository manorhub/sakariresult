---
// src/pages/admin/content/review.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db';
import { formatDate, getContentTypeLabel } from '../../../lib/utils';
import { renderMarkdownToHtml } from '../../../lib/markdown';
import type { ContentItem } from '../../../lib/types';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

// Fetch items requiring review or verification
const reviewItems = (await db.query<ContentItem>(`
  SELECT ci.*, c.name as category_name, o.name as organization_name
  FROM content_items ci
  LEFT JOIN categories c ON c.id = ci.category_id
  LEFT JOIN organizations o ON o.id = ci.organization_id
  WHERE ci.status = 'review' 
     OR ci.ai_status = 'verification_required'
     OR ci.verification_status = 'conflict_detected'
     OR ci.quality_score < 90
  ORDER BY 
    CASE WHEN ci.verification_status = 'conflict_detected' THEN 1 ELSE 2 END,
    ci.updated_at DESC
`)).results;
---

<AdminLayout title="AI Content Review Queue" subtitle="Inspect AI-extracted facts, resolve factual conflicts, review quality scores, and approve publications." activeNav="/admin/content/review">
  
  <!-- Review Queue Overview -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div class="flex items-center space-x-3">
      <div class="w-8 h-8 rounded-lg bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-600 font-bold">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div>
        <h2 class="text-sm font-bold text-slate-900">
          Pending Verification Queue ({reviewItems.length})
        </h2>
        <p class="text-xs text-slate-500">Items blocked from auto-publishing due to conflicts or quality score thresholds.</p>
      </div>
    </div>

    <div class="flex items-center space-x-2">
      <button
        type="button"
        id="btn-batch-process"
        class="px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors flex items-center space-x-1.5"
      >
        <svg class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Process Due Crawler Pages</span>
      </button>
    </div>
  </div>

  {reviewItems.length === 0 ? (
    <div class="bg-white rounded-xl border border-slate-200 p-12 text-center shadow-xs">
      <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-3">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h3 class="text-sm font-bold text-slate-900 mb-1">All Caught Up!</h3>
      <p class="text-xs text-slate-500 max-w-md mx-auto mb-4">
        No pending content items require human review. All processed notifications met quality thresholds without critical conflicts.
      </p>
      <a
        href="/admin/content"
        class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg transition-colors"
      >
        View All Published CMS Content &rarr;
      </a>
    </div>
  ) : (
    <div class="space-y-6">
      {reviewItems.map((item) => {
        let extractedData: any = {};
        let evidenceList: any[] = [];
        let conflicts: any[] = [];
        let faqs: any[] = [];

        try { if (item.extracted_data_json) extractedData = JSON.parse(item.extracted_data_json); } catch {}
        try { if (item.evidence_json) evidenceList = JSON.parse(item.evidence_json); } catch {}
        try { if (item.conflict_details_json) conflicts = JSON.parse(item.conflict_details_json); } catch {}
        try { if (item.faq_json) faqs = JSON.parse(item.faq_json); } catch {}

        const badge = getContentTypeLabel(item.type);
        const hasConflicts = conflicts.length > 0 || item.verification_status === 'conflict_detected';
        const score = item.quality_score || 0;

        return (
          <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden" id={`review-card-${item.id}`}>
            
            <!-- Card Header -->
            <div class="p-5 bg-slate-50 border-b border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3">
              <div class="min-w-0 flex-1">
                <div class="flex items-center space-x-2 mb-1.5 flex-wrap gap-y-1">
                  <span class={`px-2 py-0.5 rounded text-[10px] font-bold border ${badge.bg}`}>
                    {badge.label}
                  </span>

                  {hasConflicts ? (
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200 flex items-center space-x-1">
                      <span>⚠️ Conflict Detected</span>
                    </span>
                  ) : (
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                      Score: {score}/100 (Review Required)
                    </span>
                  )}

                  <span class="text-[11px] text-slate-400">
                    Updated {formatDate(item.updated_at)}
                  </span>
                </div>

                <h3 class="text-base font-bold text-slate-900 leading-snug">
                  {item.title}
                </h3>

                <div class="flex items-center space-x-3 text-xs text-slate-500 mt-1 flex-wrap">
                  {item.source_url && (
                    <a
                      href={item.source_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-blue-600 hover:underline flex items-center space-x-1 font-mono text-[11px]"
                    >
                      <span>Source Link &UpperRightArrow;</span>
                    </a>
                  )}
                  <span>•</span>
                  <span>Classification Confidence: <strong>{Math.round((item.classification_confidence || 0.9) * 100)}%</strong></span>
                  <span>•</span>
                  <span>Extraction Confidence: <strong>{Math.round((item.extraction_confidence || 0.9) * 100)}%</strong></span>
                </div>
              </div>

              <!-- Quality Score Badge -->
              <div class="flex items-center space-x-2 flex-shrink-0">
                <div class="text-right">
                  <div class="text-[10px] font-bold text-slate-400 uppercase">Quality Score</div>
                  <div class={`text-xl font-black ${score >= 90 ? 'text-emerald-600' : score >= 75 ? 'text-amber-600' : 'text-rose-600'}`}>
                    {score}<span class="text-xs text-slate-400 font-normal">/100</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Pipeline Status Visual Steps (Section 27) -->
            <div class="px-5 py-2.5 bg-slate-950 text-slate-300 text-[11px] font-mono flex items-center overflow-x-auto space-x-4 border-b border-slate-800">
              <span class="text-slate-400 font-bold uppercase text-[10px]">Pipeline:</span>
              <span class="text-emerald-400 flex items-center space-x-1"><span>✓</span><span>Source</span></span>
              <span class="text-slate-600">&rarr;</span>
              <span class="text-emerald-400 flex items-center space-x-1"><span>✓</span><span>Classified ({item.type})</span></span>
              <span class="text-slate-600">&rarr;</span>
              <span class="text-emerald-400 flex items-center space-x-1"><span>✓</span><span>Extracted</span></span>
              <span class="text-slate-600">&rarr;</span>
              <span class={`flex items-center space-x-1 font-bold ${hasConflicts ? 'text-rose-400' : 'text-emerald-400'}`}>
                <span>{hasConflicts ? '⚠️' : '✓'}</span>
                <span>Verification {hasConflicts ? '(Conflict)' : '(Passed)'}</span>
              </span>
              <span class="text-slate-600">&rarr;</span>
              <span class="text-emerald-400 flex items-center space-x-1"><span>✓</span><span>Generated</span></span>
              <span class="text-slate-600">&rarr;</span>
              <span class="text-emerald-400 flex items-center space-x-1"><span>✓</span><span>SEO & FAQ</span></span>
            </div>

            <!-- Conflicts Banner (If any) -->
            {conflicts.length > 0 && (
              <div class="p-4 bg-rose-50 border-b border-rose-200 text-xs text-rose-900">
                <div class="font-bold flex items-center space-x-2 mb-2 text-rose-800 text-sm">
                  <svg class="w-4 h-4 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>Verification Conflict Detected — Manual Verification Required</span>
                </div>
                <div class="space-y-2">
                  {conflicts.map((c: any) => (
                    <div class="p-2.5 bg-white rounded-lg border border-rose-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                      <div>
                        <span class="font-bold uppercase text-[10px] text-rose-700 bg-rose-100 px-1.5 py-0.5 rounded mr-2">
                          Field: {c.field}
                        </span>
                        <span class="text-slate-800 font-medium">{c.reason}</span>
                      </div>
                      <div class="text-[11px] text-slate-500 flex items-center space-x-3 flex-shrink-0 font-mono">
                        <span>AI Value: <strong class="text-rose-600">{String(c.extractedValue ?? 'null')}</strong></span>
                        {c.sourceValue && <span>Source Value: <strong class="text-emerald-600">{String(c.sourceValue)}</strong></span>}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Main Facts & Evidence Grid -->
            <div class="p-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
              
              <!-- Left Column: Extracted Facts -->
              <div>
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3 flex items-center space-x-1.5">
                  <span>Structured Extracted Facts</span>
                </h4>
                <div class="bg-slate-50 rounded-xl border border-slate-200 divide-y divide-slate-100 text-xs overflow-hidden">
                  {Object.entries(extractedData)
                    .filter(([k]) => k !== 'evidence' && k !== 'extraction_confidence')
                    .map(([key, val]) => (
                      <div class="p-2.5 flex items-start justify-between gap-2">
                        <span class="font-semibold text-slate-500 capitalize">{key.replace(/_/g, ' ')}:</span>
                        <span class={`font-mono text-right ${val ? 'text-slate-900 font-medium' : 'text-slate-400 italic'}`}>
                          {val !== null && val !== undefined ? String(val) : 'null'}
                        </span>
                      </div>
                    ))}
                </div>
              </div>

              <!-- Right Column: Source Evidence & Verified FAQs -->
              <div class="space-y-4">
                <div>
                  <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3">
                    Source Evidence Snippets ({evidenceList.length})
                  </h4>
                  {evidenceList.length === 0 ? (
                    <p class="text-xs text-slate-400 italic">No source evidence snippets captured.</p>
                  ) : (
                    <div class="space-y-2">
                      {evidenceList.map((ev: any) => (
                        <div class="p-2.5 bg-blue-50/50 rounded-lg border border-blue-100 text-xs">
                          <span class="font-bold text-blue-800 text-[10px] uppercase block mb-0.5">
                            {ev.field}: {String(ev.value ?? '')}
                          </span>
                          <p class="text-slate-700 italic font-serif">"{ev.evidence}"</p>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                <!-- Update Summary Notice (If any) -->
                {item.update_summary && (
                  <div class="p-3 bg-amber-50 rounded-lg border border-amber-200 text-xs">
                    <span class="font-bold text-amber-800 text-[11px] block mb-1">Detected Update / Corrigendum:</span>
                    <p class="text-slate-800">{item.update_summary}</p>
                  </div>
                )}

                <!-- Verified FAQs Preview (If any) -->
                {faqs.length > 0 && (
                  <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 text-xs space-y-1.5">
                    <span class="font-bold text-slate-800 text-[11px] block mb-1">Verified FAQs ({faqs.length}):</span>
                    {faqs.slice(0, 3).map((f: any) => (
                      <div class="text-[11px] text-slate-700">
                        <strong>Q: {f.question}</strong>
                        <p class="text-slate-500 pl-2">&rarr; {f.answer}</p>
                      </div>
                    ))}
                  </div>
                )}
              </div>

            </div>

            <!-- Generated Markdown Article Preview (Collapsible) -->
            {item.article_content && (
              <div class="px-6 pb-6">
                <details class="group bg-slate-50 rounded-xl border border-slate-200">
                  <summary class="p-3 text-xs font-bold text-slate-700 cursor-pointer select-none flex items-center justify-between">
                    <span>View Generated Article Markdown Preview</span>
                    <span class="text-blue-600 text-[11px] group-open:rotate-180 transition-transform">&darr;</span>
                  </summary>
                  <div class="p-5 border-t border-slate-200 text-xs prose prose-sm max-w-none text-slate-800 max-h-96 overflow-y-auto bg-white article-markdown-body" set:html={renderMarkdownToHtml(item.article_content)}>
                  </div>
                </details>
              </div>
            )}

            <!-- Admin Actions Bar -->
            <div class="p-4 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center space-x-2">
                <a
                  href={`/admin/content/${item.id}`}
                  class="px-3 py-1.5 bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-lg text-xs font-semibold transition-colors"
                >
                  Edit in CMS Editor
                </a>
                <button
                  type="button"
                  data-id={item.id}
                  data-action="regenerate"
                  class="btn-review-action px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-800 rounded-lg text-xs font-semibold transition-colors"
                >
                  Regenerate with AI
                </button>
              </div>

              <div class="flex items-center space-x-2">
                <button
                  type="button"
                  data-id={item.id}
                  data-action="reject"
                  class="btn-review-action px-3 py-1.5 bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 rounded-lg text-xs font-semibold transition-colors"
                >
                  Reject & Archive
                </button>
                <button
                  type="button"
                  data-id={item.id}
                  data-action="save_draft"
                  class="btn-review-action px-3 py-1.5 bg-amber-50 text-amber-700 hover:bg-amber-100 border border-amber-200 rounded-lg text-xs font-semibold transition-colors"
                >
                  Save as Draft
                </button>
                <button
                  type="button"
                  data-id={item.id}
                  data-action="approve_publish"
                  class="btn-review-action px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold transition-colors shadow-xs"
                >
                  Approve & Publish Immediately
                </button>
              </div>
            </div>

          </div>
        );
      })}
    </div>
  )}

</AdminLayout>

<script>
  // Handle Review Actions (Approve, Draft, Reject, Regenerate)
  document.querySelectorAll('.btn-review-action').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const action = btn.getAttribute('data-action');
      if (!id || !action) return;

      if (action === 'reject' && !confirm('Are you sure you want to reject and archive this content item?')) {
        return;
      }

      btn.setAttribute('disabled', 'true');

      try {
        const res = await fetch('/api/admin/ai/review-action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content_item_id: id, action }),
        });
        const data = (await res.json()) as any;
        if (res.ok && data.success) {
          alert(data.message || 'Action performed successfully.');
          window.location.reload();
        } else {
          alert(data.error || 'Failed to execute review action.');
          btn.removeAttribute('disabled');
        }
      } catch (err) {
        alert('Network error executing review action.');
        btn.removeAttribute('disabled');
      }
    });
  });

  // Batch Process Crawler Pages
  const batchBtn = document.getElementById('btn-batch-process') as HTMLButtonElement;
  batchBtn?.addEventListener('click', async () => {
    batchBtn.disabled = true;
    batchBtn.innerText = 'Processing Crawler Pages...';

    try {
      const res = await fetch('/api/admin/ai/batch-process', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ limit: 10 }),
      });
      const data = (await res.json()) as any;
      if (res.ok && data.success) {
        alert(`Processed ${data.processed || 0} source pages through AI pipeline.`);
        window.location.reload();
      } else {
        alert(data.error || 'Batch processing failed.');
      }
    } catch (err) {
      alert('Network error triggering batch processing.');
    } finally {
      batchBtn.disabled = false;
      batchBtn.innerText = 'Process Due Crawler Pages';
    }
  });
</script>
