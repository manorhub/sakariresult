---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Contact Us — Sarkari Info Candidate Support & Feedback"
  description="Contact the Sarkari Info editorial team for feedback, correction requests, or general inquiries regarding government notifications."
>
  <Breadcrumbs items={[{ name: 'Contact Us' }]} />

  <div class="max-w-3xl mx-auto px-4 py-10">
    <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm space-y-6">
      
      <div class="border-b border-slate-100 pb-4">
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Contact Editorial & Support
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Have questions, notices to report, or suggestions? Reach out to our team.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-5 rounded-xl bg-blue-50/60 border border-blue-200">
          <h3 class="text-xs font-bold uppercase tracking-wider text-blue-900 mb-1">General Inquiries</h3>
          <p class="text-xs text-blue-700 mb-3">Questions regarding articles, portal features, or technical issues.</p>
          <a href="mailto:support@sarkariinfo.org" class="text-xs font-bold text-blue-600 hover:underline">
            support@sarkariinfo.org &rarr;
          </a>
        </div>

        <div class="p-5 rounded-xl bg-amber-50/60 border border-amber-200">
          <h3 class="text-xs font-bold uppercase tracking-wider text-amber-900 mb-1">Corrections & Notice Verification</h3>
          <p class="text-xs text-amber-700 mb-3">Notice an error in date or vacancy count? Let our editorial desk know.</p>
          <a href="mailto:editor@sarkariinfo.org" class="text-xs font-bold text-amber-700 hover:underline">
            editor@sarkariinfo.org &rarr;
          </a>
        </div>
      </div>

      <!-- Advisory -->
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600 leading-relaxed">
        <strong>Important:</strong> We do NOT handle individual application submissions, admit card re-issues, or recruitment candidate inquiries. For candidate-specific issues with your application form or login, please contact the respective official commission/board helpline directly.
      </div>

    </div>
  </div>
</BaseLayout>
