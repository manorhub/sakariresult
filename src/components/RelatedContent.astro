---
// src/components/RelatedContent.astro
import type { PublicJobItem } from '../lib/public_queries.ts';

interface Props {
  items: PublicJobItem[];
  title?: string;
}

const { items, title = 'Related Government Notifications & Updates' } = Astro.props;

function getHref(item: PublicJobItem): string {
  if (item.type === 'job') return `/jobs/${item.slug}`;
  if (item.type === 'result') return `/results/${item.slug}`;
  if (item.type === 'admit_card') return `/admit-card/${item.slug}`;
  if (item.type === 'answer_key') return `/answer-key/${item.slug}`;
  if (item.type === 'exam') return `/exams/${item.slug}`;
  if (item.type === 'scholarship') return `/scholarships/${item.slug}`;
  if (item.type === 'syllabus') return `/syllabus/${item.slug}`;
  if (item.type === 'scheme') return `/schemes/${item.slug}`;
  return `/important-updates/${item.slug}`;
}

function getBadgeColor(type: string): string {
  switch (type) {
    case 'job': return 'bg-blue-50 text-blue-700 border-blue-200';
    case 'result': return 'bg-emerald-50 text-emerald-700 border-emerald-200';
    case 'admit_card': return 'bg-amber-50 text-amber-700 border-amber-200';
    case 'answer_key': return 'bg-purple-50 text-purple-700 border-purple-200';
    case 'exam': return 'bg-indigo-50 text-indigo-700 border-indigo-200';
    default: return 'bg-slate-50 text-slate-700 border-slate-200';
  }
}
---

{items && items.length > 0 && (
  <div class="my-10 bg-white rounded-xl border border-slate-200 p-5 sm:p-6 shadow-xs">
    <div class="flex items-center space-x-2 border-b border-slate-100 pb-3 mb-4">
      <div class="w-2.5 h-2.5 rounded-full bg-gov-saffron"></div>
      <h2 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight">
        {title}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
      {items.map((item) => (
        <a
          href={getHref(item)}
          class="p-3.5 rounded-lg border border-slate-200 hover:border-gov-navy/40 hover:bg-slate-50 transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="flex items-center justify-between gap-1 mb-1.5">
              <span class={`text-[10px] uppercase font-bold px-2 py-0.5 rounded border ${getBadgeColor(item.type)}`}>
                {item.type.replace('_', ' ')}
              </span>
              {item.calculated_status && (
                <span class="text-[10px] font-semibold text-slate-500">
                  {item.calculated_status}
                </span>
              )}
            </div>

            <h3 class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-gov-navy line-clamp-2 leading-snug">
              {item.title}
            </h3>

            {item.organization_name && (
              <p class="text-[11px] text-slate-500 mt-1 truncate">
                {item.organization_name}
              </p>
            )}
          </div>

          <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
            {item.total_vacancies ? (
              <span class="font-medium text-slate-600">
                {item.total_vacancies} Vacancies
              </span>
            ) : (
              <span>Official Notice</span>
            )}
            <span class="font-bold text-gov-saffron group-hover:translate-x-0.5 transition-transform">
              View Details &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
)}
