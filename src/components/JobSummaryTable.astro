---
// src/components/JobSummaryTable.astro
import type { PublicJobItem } from '../lib/public_queries.ts';

interface Props {
  item: PublicJobItem;
}

const { item } = Astro.props;
---

<div class="bg-white rounded-xl border border-slate-200 overflow-hidden my-6 shadow-xs">
  <div class="bg-slate-100 px-4 py-3 border-b border-slate-200 flex items-center justify-between">
    <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider">
      Quick Summary & Key Specifications
    </h2>
    <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-900">
      {item.calculated_status || 'Active'}
    </span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs border-collapse">
      <tbody class="divide-y divide-slate-100">
        <tr class="hover:bg-slate-50">
          <th class="w-1/3 py-2.5 px-4 font-semibold text-slate-600 bg-slate-50/50">Recruiting Authority</th>
          <td class="py-2.5 px-4 font-bold text-slate-900">{item.organization_name || 'Government Organization'}</td>
        </tr>
        {item.post_name && (
          <tr class="hover:bg-slate-50">
            <th class="py-2.5 px-4 font-semibold text-slate-600 bg-slate-50/50">Post / Position Name</th>
            <td class="py-2.5 px-4 font-medium text-slate-800">{item.post_name}</td>
          </tr>
        )}
        {item.total_vacancies && (
          <tr class="hover:bg-slate-50">
            <th class="py-2.5 px-4 font-semibold text-slate-600 bg-slate-50/50">Total Vacancies</th>
            <td class="py-2.5 px-4 font-bold text-emerald-700">{item.total_vacancies} Posts</td>
          </tr>
        )}
        {item.qualification && (
          <tr class="hover:bg-slate-50">
            <th class="py-2.5 px-4 font-semibold text-slate-600 bg-slate-50/50">Educational Qualification</th>
            <td class="py-2.5 px-4 font-medium text-slate-800">{item.qualification}</td>
          </tr>
        )}
        {item.age_limit && (
          <tr class="hover:bg-slate-50">
            <th class="py-2.5 px-4 font-semibold text-slate-600 bg-slate-50/50">Age Limit</th>
            <td class="py-2.5 px-4 font-medium text-slate-800">{item.age_limit}</td>
          </tr>
        )}
        {item.fee_details && (
          <tr class="hover:bg-slate-50">
            <th class="py-2.5 px-4 font-semibold text-slate-600 bg-slate-50/50">Application Fee</th>
            <td class="py-2.5 px-4 font-medium text-slate-800">{item.fee_details}</td>
          </tr>
        )}
        {item.salary && (
          <tr class="hover:bg-slate-50">
            <th class="py-2.5 px-4 font-semibold text-slate-600 bg-slate-50/50">Pay Scale / Salary</th>
            <td class="py-2.5 px-4 font-medium text-slate-800">{item.salary}</td>
          </tr>
        )}
        {item.application_start_date && (
          <tr class="hover:bg-slate-50">
            <th class="py-2.5 px-4 font-semibold text-slate-600 bg-slate-50/50">Application Start Date</th>
            <td class="py-2.5 px-4 font-medium text-slate-800">{item.application_start_date}</td>
          </tr>
        )}
        {item.application_last_date && (
          <tr class="hover:bg-slate-50">
            <th class="py-2.5 px-4 font-semibold text-slate-600 bg-slate-50/50">Application Last Date</th>
            <td class="py-2.5 px-4 font-bold text-rose-700">{item.application_last_date}</td>
          </tr>
        )}
        {item.category_name && (
          <tr class="hover:bg-slate-50">
            <th class="py-2.5 px-4 font-semibold text-slate-600 bg-slate-50/50">Job Category</th>
            <td class="py-2.5 px-4 font-medium text-slate-800">{item.category_name}</td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</div>
