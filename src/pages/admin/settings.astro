---
// src/pages/admin/settings.astro
// Centralized Global Settings & Maintenance Mode Control

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db.ts';
import { getGeneralSettings, getSiteSettings } from '../../lib/settings.ts';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const db = getDb(d1);

const general = await getGeneralSettings(db);
const site = await getSiteSettings(db);
---

<AdminLayout title="Global Platform Settings" activeNav="/admin/settings">
  <div class="max-w-3xl space-y-8">
    
    <div class="pb-3 border-b border-slate-200">
      <h1 class="text-2xl font-black text-slate-900 tracking-tight">Global Platform Settings</h1>
      <p class="text-xs text-slate-500 mt-1">Configure portal branding, maintenance mode, announcement banner, and system parameters.</p>
    </div>

    <!-- General Settings Form -->
    <form id="general-settings-form" class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-4 text-xs">
      <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider pb-2 border-b border-slate-100">
        General Information & Branding
      </h2>

      <div>
        <label class="block font-bold text-slate-700 mb-1">Portal Name</label>
        <input type="text" name="siteName" value={general.siteName} required class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5" />
      </div>

      <div>
        <label class="block font-bold text-slate-700 mb-1">Portal Tagline & Meta Description</label>
        <textarea name="description" rows="2" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5">{general.description}</textarea>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Official Contact Email</label>
          <input type="email" name="contactEmail" value={general.contactEmail} required class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Primary Canonical Domain</label>
          <input type="url" name="primaryDomain" value={general.primaryDomain} required class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5" />
        </div>
      </div>

      <div class="pt-3 flex justify-end">
        <button type="submit" class="px-5 py-2 bg-gov-navy hover:bg-slate-900 text-white font-bold rounded-xl shadow-xs transition-colors">
          Save General Settings
        </button>
      </div>
    </form>

    <!-- Site, Maintenance & Announcement Bar Form -->
    <form id="site-settings-form" class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-6 text-xs">
      <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider pb-2 border-b border-slate-100">
        Site State & Announcement Banner
      </h2>

      <!-- Maintenance Mode Switch -->
      <div class="flex items-center justify-between p-4 bg-amber-50/50 border border-amber-200 rounded-xl">
        <div>
          <span class="text-xs font-bold text-amber-950 block">Maintenance Mode</span>
          <p class="text-amber-800 text-[11px]">When active, public visitors see maintenance notice while admins retain full panel access.</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" name="maintenanceMode" checked={site.maintenanceMode} class="sr-only peer" />
          <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-600"></div>
        </label>
      </div>

      <!-- Announcement Banner -->
      <div class="space-y-3 pt-2">
        <div class="flex items-center justify-between">
          <label class="font-bold text-slate-800">Top Header Announcement Bar</label>
          <label class="flex items-center space-x-2 cursor-pointer">
            <input type="checkbox" name="announcementEnabled" checked={site.announcementBar.enabled} class="rounded border-slate-300 text-gov-navy focus:ring-0" />
            <span class="text-slate-600 text-[11px] font-semibold">Enabled</span>
          </label>
        </div>

        <div>
          <label class="block text-slate-500 text-[11px] mb-1">Banner Notification Text</label>
          <input type="text" name="announcementText" value={site.announcementBar.text} class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5" />
        </div>

        <div>
          <label class="block text-slate-500 text-[11px] mb-1">Action Link (Optional)</label>
          <input type="text" name="announcementLink" value={site.announcementBar.link || ''} placeholder="/important-updates" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5" />
        </div>
      </div>

      <div class="pt-3 flex justify-end">
        <button type="submit" class="px-5 py-2 bg-gov-navy hover:bg-slate-900 text-white font-bold rounded-xl shadow-xs transition-colors">
          Save Site Settings
        </button>
      </div>
    </form>

  </div>
</AdminLayout>

<script>
  const genForm = document.getElementById('general-settings-form') as HTMLFormElement | null;
  if (genForm) {
    genForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(genForm);
      const payload = {
        siteName: formData.get('siteName'),
        description: formData.get('description'),
        contactEmail: formData.get('contactEmail'),
        primaryDomain: formData.get('primaryDomain'),
        logo: '/logo.svg',
      };

      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ category: 'general', key: 'general_settings', value: payload }),
        });
        const data = (await res.json()) as any;
        if (data.success) alert('General settings updated successfully!');
      } catch {}
    });
  }

  const siteForm = document.getElementById('site-settings-form') as HTMLFormElement | null;
  if (siteForm) {
    siteForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(siteForm);
      const payload = {
        maintenanceMode: formData.get('maintenanceMode') === 'on',
        announcementBar: {
          enabled: formData.get('announcementEnabled') === 'on',
          text: formData.get('announcementText'),
          link: formData.get('announcementLink') || null,
        },
        defaultLanguage: 'en',
        defaultCurrency: 'INR',
      };

      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ category: 'site', key: 'site_settings', value: payload }),
        });
        const data = (await res.json()) as any;
        if (data.success) alert('Site & Maintenance settings updated!');
      } catch {}
    });
  }
</script>
